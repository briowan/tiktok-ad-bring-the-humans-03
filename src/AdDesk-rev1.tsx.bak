  const frame = useCurrentFrame();
  // Micro accent scale punch on key 120 BPM hits (zero motion on f0 & f330..374)
  const hitScale =
    1 +
    beatPunch(frame, BEATS.tokenLockHit, 0.03) +
    beatPunch(frame, BEATS.stakesLandHit, 0.035);

  return (
    <div
      style={{
        position: "absolute",
        right: 128,
        top: 306,
        height: 56,
        paddingLeft: 20,
        paddingRight: 22,
        borderRadius: 999,
        backgroundColor: THEME.colors.surface,
        border: `2px solid ${THEME.colors.lineHair}`,
        boxShadow: "0 8px 20px rgba(25,20,25,0.06)",
        display: "flex",
        alignItems: "center",
        gap: 10,
        transform: hitScale !== 1 ? `scale(${hitScale.toFixed(4)})` : undefined,
        transformOrigin: "100% 50%",
      }}
    >
      <div
        style={{
          width: 10,
          height: 10,
          borderRadius: 3,
          backgroundColor: THEME.colors.magenta,
          transform: "rotate(45deg)",
          flexShrink: 0,
        }}
      />
      <span
        style={{
          fontFamily: THEME.font,
          fontSize: 25,
          fontWeight: 700,
          letterSpacing: "0.01em",
          color: THEME.colors.ink,
          lineHeight: 1,
          whiteSpace: "nowrap",
        }}
      >
        {COPY.kicker}
      </span>
    </div>
  );
};

// ============================================================================
// HOOK HEADLINE (f0..59) — "How good is your AI agent?"
// Frame 0 is 100% sharp & crisp ("How good" pre-settled with zero blur).
// Remaining words enter word-by-word: blur->sharp + slide + spring scale punch,
// filling the safe-zone width (x124..956, y436..810, clear below badge y424).
// Whip-pan exits fast on f52..59 into META.
// ============================================================================
const HookHeadline = () => {
  const frame = useCurrentFrame(); // local 0..59 == global 0..59
  const { fps } = useVideoConfig();

  const words = COPY.hook.split(" "); // ["How", "good", "is", "your", "AI", "agent?"]
  const line1 = words.slice(0, 2); // "How", "good"
  const line2 = words.slice(2, 4); // "is", "your"
  const aiWord = words[4]; // "AI"
  const agentWordRaw = words[5]; // "agent?"
  const agentCore = agentWordRaw.slice(0, agentWordRaw.length - 1); // "agent"
  const trailingPunct = agentWordRaw.slice(agentWordRaw.length - 1); // "?"

  const aiBeatPulse = beatPunch(frame, 15, 0.045);
  const underlineProgress = clampInterp(
    frame,
    [22, 30],
    [0, 1],
    THEME.ease.outCubic,
  );
  const haloOpacity = clampInterp(
    frame,
    [15, 24],
    [0, 0.24],
    THEME.ease.outCubic,
  );

  // Fast whip-pan exit (f52..59) directly into META match-cut
  const exitT = clampInterp(frame, [52, 59], [0, 1], THEME.ease.inCubic);
  const exitX = exitT * -420;
  const exitScale = 1 - exitT * 0.05;
  const exitBlur = exitT * 9;
  const opacity = clampInterp(frame, [53, 59], [1, 0], THEME.ease.inCubic);

  return (
    <div
      style={{
        position: "absolute",
        left: 124,
        top: 438,
        width: 832,
        opacity,
        transform: `translateX(${exitX.toFixed(1)}px) scale(${exitScale.toFixed(4)})`,
        transformOrigin: "50% 45%",
        filter: exitBlur > 0.2 ? `blur(${exitBlur.toFixed(1)}px)` : undefined,
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        textAlign: "center",
        gap: 4,
      }}
    >
      {/* Line 1: "How good" — 100% razor-sharp on frame 0 */}
      <div
        style={{
          display: "flex",
          justifyContent: "center",
          alignItems: "baseline",
          columnGap: 24,
        }}
      >
        {line1.map((word, idx) => (
          <KineticWord
            key={idx}
            frame={frame}
            fps={fps}
            start={0}
            preSettled={true}
            style={{
              fontSize: 122,
              fontWeight: 900,
              lineHeight: 0.95,
              letterSpacing: "-0.04em",
              color: THEME.colors.ink,
            }}
          >
            {word}
          </KineticWord>
        ))}
      </div>

      {/* Line 2: "is your" — word-by-word blur->sharp + slide + spring punch */}
      <div
        style={{
          display: "flex",
          justifyContent: "center",
          alignItems: "baseline",
          columnGap: 22,
        }}
      >
        <KineticWord
          frame={frame}
          fps={fps}
          start={4}
          settleDuration={9}
          blurDuration={4}
          blurFrom={14}
          slideY={42}
          scaleFrom={0.68}
          style={{
            fontSize: 100,
            fontWeight: 800,
            lineHeight: 0.96,
            letterSpacing: "-0.035em",
            color: THEME.colors.ink,
          }}
        >
          {line2[0]}
        </KineticWord>
        <KineticWord
          frame={frame}
          fps={fps}
          start={9}
          settleDuration={9}
          blurDuration={4}
          blurFrom={14}
          slideY={42}
          scaleFrom={0.68}
          style={{
            fontSize: 100,
            fontWeight: 800,
            lineHeight: 0.96,
            letterSpacing: "-0.035em",
            color: THEME.colors.ink,
          }}
        >
          {line2[1]}
        </KineticWord>
      </div>

      {/* Line 3: "AI agent?" — MASSIVE hero line slamming in on 120 BPM Beat 1 (f15) */}
      <div
        style={{
          position: "relative",
          display: "inline-flex",
          alignItems: "baseline",
          justifyContent: "center",
          columnGap: 24,
          marginTop: 2,
        }}
      >
        {/* Subtle studio glow behind accented "AI agent" */}
        {haloOpacity > 0.01 && (
          <div
            style={{
              position: "absolute",
              left: -32,
              right: 22,
              top: -12,
              bottom: -16,
              borderRadius: 999,
              background: `radial-gradient(ellipse at center, rgba(196,28,131,${haloOpacity.toFixed(3)}) 0%, rgba(196,28,131,0) 72%)`,
              pointerEvents: "none",
            }}
          />
        )}

        <KineticWord
          frame={frame}
          fps={fps}
          start={12}
          settleDuration={10}
          blurDuration={3}
          blurFrom={16}
          slideY={52}
          scaleFrom={0.62}
          extraPunch={aiBeatPulse}
          style={{
            fontSize: 150,
            fontWeight: 900,
            lineHeight: 0.96,
            letterSpacing: "-0.045em",
            color: THEME.colors.magenta,
          }}
        >
          {aiWord}
        </KineticWord>

        <KineticWord
          frame={frame}
          fps={fps}
          start={18}
          settleDuration={11}
          blurDuration={4}
          blurFrom={16}
          slideY={52}
          scaleFrom={0.64}
          style={{
            fontSize: 150,
            fontWeight: 900,
            lineHeight: 0.96,
            letterSpacing: "-0.045em",
          }}
        >
          <span style={{ color: THEME.colors.magenta }}>{agentCore}</span>
          <span style={{ color: THEME.colors.ink }}>{trailingPunct}</span>
        </KineticWord>

        {/* Gradient accent underline locking on 120 BPM Beat 2 (f30) */}
        <div
          style={{
            position: "absolute",
            left: 4,
            right: 76,
            bottom: -10,
            height: 9,
            borderRadius: 5,
            background: `linear-gradient(90deg, ${THEME.colors.magenta} 0%, ${THEME.colors.cyan} 100%)`,
            transform: `scaleX(${underlineProgress.toFixed(4)})`,
            transformOrigin: "0% 50%",
          }}
        />
      </div>
    </div>
  );
};

// ============================================================================
// TACTILE "AI AGENT" HARDWARE CARTRIDGE TOKEN (NOT A COIN!)
// Enlarged 286x146 chamfered key-cartridge with connector tongue, grip ribs,
// uniform #FFFFFF relief bed for all 3 Kiro mascot SVGs (zero flash),
// dynamic contact shadow scaling with elevation/lock impact, and "AI AGENT".
// ============================================================================
const AgentToken = ({
  x,
  y,
  scale,
  rotateY,
  rotateX,
  elevation,
  isLocked,
  happyOpacity,
  playOpacity,
  fullOpacity,
}: {
  x: number;
  y: number;
  scale: number;
  rotateY: number;
  rotateX: number;
  elevation: number;
  isLocked: boolean;
  happyOpacity: number;
  playOpacity: number;
  fullOpacity: number;
}) => {
  const tokenW = 286;
  const tokenH = 146;

  // Dynamic grounded contact shadow responds directly to elevation
  const shadowScaleX = 0.95 + elevation * 0.008;
  const shadowScaleY = 0.92 + elevation * 0.009;
  const shadowOffsetY = 12 + elevation * 0.95;
  const shadowBlur = 7 + elevation * 0.55;
  const shadowOpacity = clamp(0.26 - elevation * 0.0045, 0.11, 0.28);

  return (
    <div
      style={{
        position: "absolute",
        left: x - tokenW / 2,
        top: y - tokenH / 2,
        width: tokenW,
        height: tokenH,
      }}
    >
      {/* Dynamic grounded contact shadow (expands & softens with elevation, tightens on lock!) */}
      <div
        style={{
          position: "absolute",
          left: 8,
          right: 4,
          top: shadowOffsetY,
          bottom: -10,
          borderRadius: 22,
          backgroundColor: `rgba(25,20,25,${shadowOpacity.toFixed(3)})`,
          filter: `blur(${shadowBlur.toFixed(1)}px)`,
          transform: `scale(${(shadowScaleX * scale).toFixed(4)}, ${(shadowScaleY * scale).toFixed(4)})`,
          transformOrigin: "50% 50%",
        }}
      />

      {/* Elevated 3D cartridge body */}
      <div
        style={{
          position: "relative",
          width: "100%",
          height: "100%",
          transform: `perspective(1200px) translateY(${(-elevation).toFixed(2)}px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale(${scale.toFixed(4)})`,
          transformOrigin: "50% 50%",
        }}
      >
        {/* Right-side hardware connector tongue (mates into make.fun desk slot) */}
        <div
          style={{
            position: "absolute",
            right: -16,
            top: 38,
            width: 26,
            height: 70,
            borderRadius: "0 12px 12px 0",
            backgroundColor: isLocked ? THEME.colors.cyan : THEME.colors.deskSide,
            border: `3.5px solid ${THEME.colors.ink}`,
            borderLeft: "none",
            display: "flex",
            flexDirection: "column",
            justifyContent: "center",
            alignItems: "center",
            gap: 8,
          }}
        >
          {[0, 1, 2].map((pin) => (
            <div
              key={pin}
              style={{
                width: 10,
                height: 4.5,
                borderRadius: 2,
                backgroundColor: isLocked ? THEME.colors.ink : THEME.colors.inkMuted,
              }}
            />
          ))}
        </div>

        {/* Extruded 3D thickness lip underneath cartridge */}
        <div
          style={{
            position: "absolute",
            inset: 0,
            transform: "translateY(10px)",
            borderRadius: 18,
            backgroundColor: THEME.colors.ink,
          }}
        />

        {/* Main tactile hardware cartridge chassis */}
        <div
          style={{
            position: "relative",
            width: "100%",
            height: "100%",
            borderRadius: 18,
            backgroundColor: THEME.colors.surface,
            border: `3.5px solid ${THEME.colors.ink}`,
            boxShadow: isLocked
              ? "0 0 0 4px rgba(34,211,238,0.32), inset 0 2px 0 rgba(255,255,255,0.95)"
              : "inset 0 2px 0 rgba(255,255,255,0.95)",
            display: "flex",
            alignItems: "center",
            paddingLeft: 14,
            paddingRight: 16,
            gap: 13,
            overflow: "hidden",
          }}
        >
          {/* Top brand keystripe */}
          <div
            style={{
              position: "absolute",
              left: 0,
              right: 0,
              top: 0,
              height: 10,
              background: isLocked
                ? `linear-gradient(90deg, ${THEME.colors.magenta} 0%, ${THEME.colors.cyan} 100%)`
                : THEME.colors.magenta,
            }}
          />

          {/* Left tactile grip ribs (distinctly hardware cartridge, never coin) */}
          <div
            style={{
              display: "flex",
              flexDirection: "column",
              gap: 7,
              paddingTop: 6,
              flexShrink: 0,
            }}
          >
            {[0, 1, 2, 3].map((rib) => (
              <div
                key={rib}
                style={{
                  width: 7,
                  height: 13,
                  borderRadius: 3.5,
                  backgroundColor: THEME.colors.deskSide,
                  border: `1.5px solid ${THEME.colors.deskStroke}`,
                }}
              />
            ))}
          </div>

          {/* Uniform #FFFFFF Mascot Relief Bay (identical backing for all 3 SVGs -> zero flash) */}
          <div
            style={{
              position: "relative",
              width: 84,
              height: 84,
              marginTop: 6,
              borderRadius: 14,
              backgroundColor: "#FFFFFF",
              border: `2px solid ${THEME.colors.lineHair}`,
              boxShadow: "inset 0 2px 6px rgba(25,20,25,0.09)",
              flexShrink: 0,
              overflow: "hidden",
            }}
          >
            <Img
              src={MASCOT_ASSETS.happy}
              alt=""
              style={{
                position: "absolute",
                inset: 6,
                width: "calc(100% - 12px)",
                height: "calc(100% - 12px)",
                objectFit: "contain",
                opacity: happyOpacity,
              }}
            />
            <Img
              src={MASCOT_ASSETS.play}
              alt=""
              style={{
                position: "absolute",
                inset: 6,
                width: "calc(100% - 12px)",
                height: "calc(100% - 12px)",
                objectFit: "contain",
                opacity: playOpacity,
              }}
            />
            <Img
              src={MASCOT_ASSETS.full}
              alt=""
              style={{
                position: "absolute",
                inset: 6,
                width: "calc(100% - 12px)",
                height: "calc(100% - 12px)",
                objectFit: "contain",
                opacity: fullOpacity,
              }}
            />
          </div>

          {/* Nameplate block — verbatim "AI AGENT" */}
          <div
            style={{
              display: "flex",
              flexDirection: "column",
              justifyContent: "center",
              gap: 8,
              marginTop: 6,
              flex: 1,
            }}
          >
            <span
              style={{
                fontFamily: THEME.font,
                fontSize: 27,
                fontWeight: 900,
                letterSpacing: "0.02em",
                color: THEME.colors.ink,
                lineHeight: 1.04,
                whiteSpace: "nowrap",
              }}
            >
              {COPY.token}
            </span>
            {/* Precision status LED geometry (zero extra text) */}
            <div style={{ display: "flex", alignItems: "center", gap: 7 }}>
              <div
                style={{
                  width: 54,
                  height: 7,
                  borderRadius: 4,
                  backgroundColor: isLocked ? THEME.colors.cyan : THEME.colors.magenta,
                }}
              />
              <div
                style={{
                  width: 14,
                  height: 7,
                  borderRadius: 4,
                  backgroundColor: isLocked ? THEME.colors.magenta : THEME.colors.deskStroke,
                }}
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

// ============================================================================
// EDITORIAL GEOMETRIC HAND PUSHING THE TOKEN INTO THE SLOT (f0..76)
// Locks token at f45, holds tactile detent briefly, then exits cleanly f56..74.
// ============================================================================
const PushingHand = ({
  tokenLeftX,
  tokenCenterY,
  frame,
}: {
  tokenLeftX: number;
  tokenCenterY: number;
  frame: number;
}) => {
  if (frame > 76) {
    return null;
  }

  const detentCompress =
    frame >= 43 && frame <= 54
      ? Math.sin(clampInterp(frame, [43, 54], [0, Math.PI])) * 6
      : 0;
  const exitT = clampInterp(frame, [56, 74], [0, 1], THEME.ease.inCubic);
  const exitX = exitT * -420;
  const exitY = exitT * -24;
  const exitOpacity = clampInterp(frame, [62, 74], [1, 0], THEME.ease.inCubic);

  const handWidth = 300;
  const handHeight = 160;
  const handLeft = tokenLeftX - handWidth + 24 + detentCompress + exitX;
  const handTop = tokenCenterY - handHeight / 2 + 4 + exitY;

  return (
    <div
      style={{
        position: "absolute",
        left: handLeft,
        top: handTop,
        width: handWidth,
        height: handHeight,
        opacity: exitOpacity,
        pointerEvents: "none",
      }}
    >
      <svg width={handWidth} height={handHeight} viewBox="0 0 280 148">
        <ellipse cx={162} cy={126} rx={94} ry={17} fill="rgba(25,20,25,0.15)" />
        <path
          d="M 0 36 L 86 36 Q 98 36 98 48 L 98 106 Q 98 118 86 118 L 0 118 Z"
          fill={THEME.colors.ink}
        />
        <rect x={70} y={36} width={10} height={82} fill={THEME.colors.magenta} />
        <path
          d="M 94 42 L 184 42 Q 204 42 214 50 L 252 50 Q 266 50 266 63 Q 266 75 252 75 L 258 75 Q 270 75 270 87 Q 270 99 256 99 L 242 99 Q 252 99 252 110 Q 252 120 238 120 L 166 120 Q 140 120 124 112 L 94 112 Z"
          fill="#F4D7C8"
          stroke={THEME.colors.ink}
          strokeWidth={3.5}
          strokeLinejoin="round"
        />
        <path
          d="M 150 42 Q 170 22 204 28 Q 222 31 224 44 Q 225 52 212 54 L 168 54"
          fill="#F4D7C8"
          stroke={THEME.colors.ink}
          strokeWidth={3.5}
          strokeLinecap="round"
          strokeLinejoin="round"
        />
        <line
          x1={206}
          y1={75}
          x2={252}
          y2={75}
          stroke={THEME.colors.ink}
          strokeWidth={3}
          strokeLinecap="round"
        />
        <line
          x1={202}
          y1={99}
          x2={244}
          y2={99}
          stroke={THEME.colors.ink}
          strokeWidth={3}
          strokeLinecap="round"
        />
        <path
          d="M 184 62 Q 188 74 184 86"
          fill="none"
          stroke="rgba(25,20,25,0.22)"
          strokeWidth={2.5}
          strokeLinecap="round"
        />
      </svg>
    </div>
  );
};

// ============================================================================
// ARENA MODULE 1: "SOLVER" — SOLVED MAZE PROOF (LANDS ON 120 BPM BEAT f150)
// ============================================================================
const SolverModule = ({
  frame,
  fps,
  left,
  top,
  scale,
  lift,
  rotateY,
  opacity,
}: {
  frame: number;
  fps: number;
  left: number;
  top: number;
  scale: number;
  lift: number;
  rotateY: number;
  opacity: number;
}) => {
  // Exact 550px orthogonal maze path solved across f150..165 (locks on Beat 11 f165!)
  const pathLen = 550;
  const solveT = clampInterp(frame, [150, 165], [0, 1], THEME.ease.inOutCubic);
  const solvedDone = frame >= 165;
  const goalBurst = spring({
    frame: Math.max(0, frame - 165),
    fps,
    config: THEME.spring.snappy,
  });

  // Dynamic grounded contact shadow reacting to spring pop lift & landing slam
  const shadowScale = scale * (0.97 + lift * 0.0055);
  const shadowY = 12 + lift * 0.85;
  const shadowBlur = 12 + lift * 0.65;
  const shadowAlpha = clamp(0.22 - lift * 0.004, 0.1, 0.24);

  return (
    <div
      style={{
        position: "absolute",
        left,
        top,
        width: 372,
        height: 300,
        opacity,
      }}
    >
      {/* Dynamic grounded contact shadow */}
      <div
        style={{
          position: "absolute",
          left: 10,
          right: 10,
          top: shadowY,
          bottom: -8,
          borderRadius: 24,
          backgroundColor: `rgba(25,20,25,${shadowAlpha.toFixed(3)})`,
          filter: `blur(${shadowBlur.toFixed(1)}px)`,
          transform: `scale(${shadowScale.toFixed(4)})`,
          transformOrigin: "50% 50%",
        }}
      />

      {/* Module card body */}
      <div
        style={{
          position: "relative",
          width: "100%",
          height: "100%",
          transform: `perspective(1200px) translateY(${(-lift).toFixed(2)}px) rotateY(${rotateY.toFixed(2)}deg) scale(${scale.toFixed(4)})`,
          transformOrigin: "50% 50%",
          borderRadius: 24,
          backgroundColor: THEME.colors.surface,
          border: `3.5px solid ${THEME.colors.ink}`,
          overflow: "hidden",
          display: "flex",
          flexDirection: "column",
        }}
      >
        {/* Header strip — verbatim "SOLVER" */}
        <div
          style={{
            height: 62,
            paddingLeft: 20,
            paddingRight: 20,
            borderBottom: `2px solid ${THEME.colors.lineHair}`,
            backgroundColor: THEME.colors.surfaceSoft,
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
          }}
        >
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            <div
              style={{
                width: 14,
                height: 14,
                borderRadius: 3,
                backgroundColor: THEME.colors.magenta,
                transform: "rotate(45deg)",
              }}
            />
            <span
              style={{
                fontFamily: THEME.font,
                fontSize: 30,
                fontWeight: 900,
                letterSpacing: "0.03em",
                color: THEME.colors.ink,
              }}
            >
              {COPY.modules.solver}
            </span>
          </div>
          <div
            style={{
              width: 18,
              height: 18,
              borderRadius: "50%",
              backgroundColor: solvedDone ? THEME.colors.cyan : THEME.colors.deskSide,
              border: `2.5px solid ${THEME.colors.ink}`,
              transform: solvedDone
                ? `scale(${(1 + beatPunch(frame, 165, 0.24)).toFixed(3)})`
                : undefined,
            }}
          />
        </div>

        {/* Maze visual body */}
        <div
          style={{
            flex: 1,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            backgroundColor: THEME.colors.surface,
          }}
        >
          <svg width={344} height={206} viewBox="0 0 340 184">
            <rect
              x={20}
              y={17}
              width={300}
              height={150}
              rx={12}
              fill={THEME.colors.bgBase}
              stroke={THEME.colors.ink}
              strokeWidth={3.5}
            />
            {[0, 1, 2, 3, 4, 5].map((c) =>
              [0, 1, 2].map((r) => (
                <circle
                  key={`${c}-${r}`}
                  cx={45 + c * 50}
                  cy={42 + r * 50}
                  r={2.5}
                  fill={THEME.colors.deskStroke}
                />
              )),
            )}
            <g
              stroke={THEME.colors.ink}
              strokeWidth={5}
              strokeLinecap="round"
              fill="none"
            >
              <line x1={70} y1={67} x2={70} y2={167} />
              <line x1={120} y1={17} x2={120} y2={67} />
              <line x1={120} y1={117} x2={120} y2={167} />
              <line x1={170} y1={67} x2={170} y2={167} />
              <line x1={220} y1={17} x2={220} y2={117} />
              <line x1={270} y1={17} x2={270} y2={67} />
              <line x1={270} y1={117} x2={270} y2={167} />
              <line x1={20} y1={67} x2={70} y2={67} />
              <line x1={70} y1={117} x2={170} y2={117} />
              <line x1={220} y1={67} x2={270} y2={67} />
            </g>

            <defs>
              <linearGradient
                id="solverRouteGrad"
                x1="0%"
                y1="0%"
                x2="100%"
                y2="100%"
              >
                <stop offset="0%" stopColor={THEME.colors.cyan} />
                <stop offset="100%" stopColor={THEME.colors.magenta} />
              </linearGradient>
            </defs>
            <path
              d="M 45 42 L 95 42 L 95 92 L 145 92 L 145 42 L 195 42 L 195 142 L 245 142 L 245 92 L 295 92 L 295 142"
              fill="none"
              stroke="url(#solverRouteGrad)"
              strokeWidth={10}
              strokeLinecap="round"
              strokeLinejoin="round"
              strokeDasharray={pathLen}
              strokeDashoffset={pathLen * (1 - solveT)}
            />

            <circle
              cx={45}
              cy={42}
              r={10}
              fill={THEME.colors.cyan}
              stroke={THEME.colors.ink}
              strokeWidth={3}
            />

            {solvedDone && (
              <circle
                cx={295}
                cy={142}
                r={10 + clamp01(goalBurst) * 18}
                fill="none"
                stroke={THEME.colors.magenta}
                strokeWidth={3.5}
                strokeOpacity={clamp01(1 - goalBurst)}
              />
            )}
            <rect
              x={284}
              y={131}
              width={22}
              height={22}
              rx={6}
              fill={solvedDone ? THEME.colors.magenta : THEME.colors.surface}
              stroke={THEME.colors.ink}
              strokeWidth={3}
            />
            {solvedDone && (
              <path
                d="M 290 142 L 294 146 L 301 138"
                fill="none"
                stroke="#FFFFFF"
                strokeWidth={3}
                strokeLinecap="round"
                strokeLinejoin="round"
              />
            )}
          </svg>
        </div>
      </div>
    </div>
  );
};

// ============================================================================
// ARENA MODULE 2: "CSV" — PARSED ROWS PROOF (LANDS ON 120 BPM BEAT f180)
// ============================================================================
const CSV_ROW_WIDTHS: readonly (readonly [number, number, number])[] = [
  [78, 96, 52],
  [62, 82, 68],
  [86, 70, 58],
  [70, 102, 48],
];

const CsvModule = ({
  frame,
  fps,
  left,
  top,
  scale,
  lift,
  rotateY,
  opacity,
}: {
  frame: number;
  fps: number;
  left: number;
  top: number;
  scale: number;
  lift: number;
  rotateY: number;
  opacity: number;
}) => {
  // Scan beam sweeps across rows 0..3 across f180..195 (locks on Beat 13 f195!)
  const scanProgress = clampInterp(
    frame,
    [180, 195],
    [0, 1],
    THEME.ease.inOutCubic,
  );
  const scanActive = frame >= 180 && frame <= 199;
  const allParsed = frame >= 195;

  // Dynamic grounded contact shadow
  const shadowScale = scale * (0.97 + lift * 0.0055);
  const shadowY = 12 + lift * 0.85;
  const shadowBlur = 12 + lift * 0.65;
  const shadowAlpha = clamp(0.22 - lift * 0.004, 0.1, 0.24);

  return (
    <div
      style={{
        position: "absolute",
        left,
        top,
        width: 372,
        height: 300,
        opacity,
      }}
    >
      {/* Dynamic grounded contact shadow */}
      <div
        style={{
          position: "absolute",
          left: 10,
          right: 10,
          top: shadowY,
          bottom: -8,
          borderRadius: 24,
          backgroundColor: `rgba(25,20,25,${shadowAlpha.toFixed(3)})`,
          filter: `blur(${shadowBlur.toFixed(1)}px)`,
          transform: `scale(${shadowScale.toFixed(4)})`,
          transformOrigin: "50% 50%",
        }}
      />

      {/* Module card body */}
      <div
        style={{
          position: "relative",
          width: "100%",
          height: "100%",
          transform: `perspective(1200px) translateY(${(-lift).toFixed(2)}px) rotateY(${rotateY.toFixed(2)}deg) scale(${scale.toFixed(4)})`,
          transformOrigin: "50% 50%",
          borderRadius: 24,
          backgroundColor: THEME.colors.surface,
          border: `3.5px solid ${THEME.colors.ink}`,
          overflow: "hidden",
          display: "flex",
          flexDirection: "column",
        }}
      >
        {/* Header strip — verbatim "CSV" */}
        <div
          style={{
            height: 62,
            paddingLeft: 20,
            paddingRight: 20,
            borderBottom: `2px solid ${THEME.colors.lineHair}`,
            backgroundColor: THEME.colors.surfaceSoft,
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
          }}
        >
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            <div
              style={{
                width: 15,
                height: 15,
                borderRadius: 4,
                backgroundColor: THEME.colors.cyan,
                border: `2px solid ${THEME.colors.ink}`,
              }}
            />
            <span
              style={{
                fontFamily: THEME.font,
                fontSize: 30,
                fontWeight: 900,
                letterSpacing: "0.03em",
                color: THEME.colors.ink,
              }}
            >
              {COPY.modules.csv}
            </span>
          </div>
          <div
            style={{
              width: 18,
              height: 18,
              borderRadius: "50%",
              backgroundColor: allParsed ? THEME.colors.cyan : THEME.colors.deskSide,
              border: `2.5px solid ${THEME.colors.ink}`,
              transform: allParsed
                ? `scale(${(1 + beatPunch(frame, 195, 0.24)).toFixed(3)})`
                : undefined,
            }}
          />
        </div>

        {/* Structured tabular rows body (pure bars + check glyphs, zero extra text) */}
        <div
          style={{
            position: "relative",
            flex: 1,
            padding: "18px 18px",
            display: "flex",
            flexDirection: "column",
            justifyContent: "space-between",
          }}
        >
          <div
            style={{
              position: "absolute",
              left: 120,
              top: 16,
              bottom: 16,
              width: 1.5,
              backgroundColor: THEME.colors.lineHair,
            }}
          />
          <div
            style={{
              position: "absolute",
              left: 236,
              top: 16,
              bottom: 16,
              width: 1.5,
              backgroundColor: THEME.colors.lineHair,
            }}
          />

          {CSV_ROW_WIDTHS.map((widths, rowIdx) => {
            const rowStart = 181 + rowIdx * 4;
            const rowPop = boundedSpring(
              frame,
              rowStart,
              fps,
              THEME.spring.punch,
              8,
            );
            const isParsed = frame >= rowStart + 2;
            const rowScale = 0.94 + rowPop * 0.06;
            return (
              <div
                key={rowIdx}
                style={{
                  position: "relative",
                  height: 44,
                  borderRadius: 11,
                  paddingLeft: 10,
                  paddingRight: 10,
                  backgroundColor: isParsed ? THEME.colors.bgBase : "#FBF9FD",
                  border: `2px solid ${isParsed ? THEME.colors.ink : THEME.colors.lineHair}`,
                  boxShadow: isParsed
                    ? "0 3px 0 rgba(25,20,25,0.10)"
                    : "none",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                  transform: `scale(${rowScale.toFixed(4)})`,
                }}
              >
                <div style={{ width: 92, display: "flex", alignItems: "center" }}>
                  <div
                    style={{
                      width: widths[0],
                      height: 13,
                      borderRadius: 6,
                      backgroundColor: isParsed
                        ? THEME.colors.magenta
                        : THEME.colors.deskSide,
                    }}
                  />
                </div>
                <div style={{ width: 106, display: "flex", alignItems: "center" }}>
                  <div
                    style={{
                      width: widths[1],
                      height: 13,
                      borderRadius: 6,
                      backgroundColor: isParsed
                        ? THEME.colors.ink
                        : THEME.colors.deskSide,
                    }}
                  />
                </div>
                <div style={{ width: 72, display: "flex", alignItems: "center" }}>
                  <div
                    style={{
                      width: widths[2],
                      height: 13,
                      borderRadius: 6,
                      backgroundColor: isParsed
                        ? THEME.colors.cyan
                        : THEME.colors.deskSide,
                    }}
                  />
                </div>
                <div
                  style={{
                    width: 19,
                    height: 19,
                    borderRadius: "50%",
                    backgroundColor: isParsed
                      ? THEME.colors.cyan
                      : THEME.colors.deskSide,
                    border: `2px solid ${THEME.colors.ink}`,
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    flexShrink: 0,
                  }}
                >
                  {isParsed && (
                    <svg width={10} height={10} viewBox="0 0 10 10">
                      <path
                        d="M 2 5 L 4.2 7.2 L 8.2 2.8"
                        fill="none"
                        stroke={THEME.colors.ink}
                        strokeWidth={2}
                        strokeLinecap="round"
                        strokeLinejoin="round"
                      />
                    </svg>
                  )}
                </div>
              </div>
            );
          })}

          {/* Sweeping cyan scan beam */}
          {scanActive && (
            <div
              style={{
                position: "absolute",
                left: 14,
                right: 14,
                top: 16 + scanProgress * 196,
                height: 5,
                borderRadius: 3,
                backgroundColor: THEME.colors.cyan,
                boxShadow: "0 0 16px rgba(34,211,238,0.85)",
                opacity: clampInterp(frame, [195, 199], [1, 0]),
              }}
            />
          )}
        </div>
      </div>
    </div>
  );
};

// ============================================================================
// ARENA MODULE 3: "TINY VM" — STACKED VM BLOCKS PROOF (LANDS ON BEAT f210)
// ============================================================================
const VM_STACK_BLOCKS: readonly {
  bay: number;
  slot: number;
  color: string;
  accent: string;
  delay: number;
}[] = [
  { bay: 0, slot: 0, color: THEME.colors.ink, accent: THEME.colors.cyan, delay: 210 },
  { bay: 0, slot: 1, color: THEME.colors.surfaceSoft, accent: THEME.colors.magenta, delay: 212 },
  { bay: 1, slot: 0, color: THEME.colors.magenta, accent: "#FFFFFF", delay: 214 },
  { bay: 1, slot: 1, color: THEME.colors.ink, accent: THEME.colors.cyan, delay: 216 },
  { bay: 2, slot: 0, color: THEME.colors.cyan, accent: THEME.colors.ink, delay: 218 },
  { bay: 2, slot: 1, color: THEME.colors.surface, accent: THEME.colors.magenta, delay: 220 },
];

const TinyVmModule = ({
  frame,
  fps,
  left,
  top,
  scale,
  lift,
  rotateX,
  opacity,
}: {
  frame: number;
  fps: number;
  left: number;
  top: number;
  scale: number;
  lift: number;
  rotateX: number;
  opacity: number;
}) => {
  // Bus locks right on 120 BPM Beat 15 (f225!)
  const busActive = clampInterp(frame, [218, 225], [0, 1], THEME.ease.outCubic);
  const vmReady = frame >= 225;

  // Dynamic grounded contact shadow
  const shadowScale = scale * (0.97 + lift * 0.005);
  const shadowY = 14 + lift * 0.85;
  const shadowBlur = 14 + lift * 0.65;
  const shadowAlpha = clamp(0.22 - lift * 0.004, 0.1, 0.24);

  return (
    <div
      style={{
        position: "absolute",
        left,
        top,
        width: 760,
        height: 294,
        opacity,
      }}
    >
      {/* Dynamic grounded contact shadow */}
      <div
        style={{
          position: "absolute",
          left: 16,
          right: 16,
          top: shadowY,
          bottom: -10,
          borderRadius: 26,
          backgroundColor: `rgba(25,20,25,${shadowAlpha.toFixed(3)})`,
          filter: `blur(${shadowBlur.toFixed(1)}px)`,
          transform: `scale(${shadowScale.toFixed(4)})`,
          transformOrigin: "50% 50%",
        }}
      />

      {/* Module card body */}
      <div
        style={{
          position: "relative",
          width: "100%",
          height: "100%",
          transform: `perspective(1200px) translateY(${(-lift).toFixed(2)}px) rotateX(${rotateX.toFixed(2)}deg) scale(${scale.toFixed(4)})`,
          transformOrigin: "50% 50%",
          borderRadius: 24,
          backgroundColor: THEME.colors.surface,
          border: `3.5px solid ${THEME.colors.ink}`,
          overflow: "hidden",
          display: "flex",
          flexDirection: "column",
        }}
      >
        {/* Header strip — verbatim "TINY VM" */}
        <div
          style={{
            height: 62,
            paddingLeft: 24,
            paddingRight: 24,
            borderBottom: `2px solid ${THEME.colors.lineHair}`,
            backgroundColor: THEME.colors.surfaceSoft,
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
          }}
        >
          <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
            <div style={{ display: "flex", gap: 3 }}>
              <div
                style={{
                  width: 9,
                  height: 16,
                  borderRadius: 2.5,
                  backgroundColor: THEME.colors.ink,
                }}
              />
              <div
                style={{
                  width: 9,
                  height: 16,
                  borderRadius: 2.5,
                  backgroundColor: THEME.colors.magenta,
                }}
              />
            </div>
            <span
              style={{
                fontFamily: THEME.font,
                fontSize: 30,
                fontWeight: 900,
                letterSpacing: "0.03em",
                color: THEME.colors.ink,
              }}
            >
              {COPY.modules.vm}
            </span>
          </div>
          <div
            style={{
              width: 18,
              height: 18,
              borderRadius: "50%",
              backgroundColor: vmReady ? THEME.colors.cyan : THEME.colors.deskSide,
              border: `2.5px solid ${THEME.colors.ink}`,
              transform: vmReady
                ? `scale(${(1 + beatPunch(frame, 225, 0.24)).toFixed(3)})`
                : undefined,
            }}
          />
        </div>

        {/* Enlarged 3-bay architectural VM block rack */}
        <div
          style={{
            position: "relative",
            flex: 1,
            padding: "20px 28px 22px 28px",
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
          }}
        >
          {[0, 1, 2].map((bayIdx) => {
            const bayBlocks = VM_STACK_BLOCKS.filter((b) => b.bay === bayIdx);
            return (
              <div
                key={bayIdx}
                style={{
                  position: "relative",
                  width: 204,
                  height: 178,
                  borderRadius: 16,
                  backgroundColor: THEME.colors.bgBase,
                  border: `2px dashed ${THEME.colors.deskStroke}`,
                  padding: 13,
                  display: "flex",
                  flexDirection: "column-reverse",
                  gap: 12,
                }}
              >
                {bayBlocks.map((block) => {
                  const p = boundedSpring(
                    frame,
                    block.delay,
                    fps,
                    THEME.spring.punch,
                    9,
                  );
                  const dropY = (1 - p) * -60;
                  const blockScale = 0.8 + p * 0.2;
                  const blockShadowY = 4 + Math.max(0, 1 - p) * 10;
                  const blockShadowAlpha = clamp(0.18 - Math.max(0, 1 - p) * 0.1, 0.05, 0.2);

                  return (
                    <div
                      key={`${block.bay}-${block.slot}`}
                      style={{
                        height: 68,
                        borderRadius: 12,
                        backgroundColor: block.color,
                        border: `2.5px solid ${THEME.colors.ink}`,
                        boxShadow: `0 ${blockShadowY.toFixed(1)}px ${Math.max(0, (1 - p) * 10).toFixed(1)}px rgba(25,20,25,${blockShadowAlpha.toFixed(3)})`,
                        opacity: clamp01(p * 1.5),
                        transform: `translateY(${dropY.toFixed(2)}px) scale(${blockScale.toFixed(4)})`,
                        display: "flex",
                        alignItems: "center",
                        justifyContent: "space-between",
                        paddingLeft: 16,
                        paddingRight: 16,
                      }}
                    >
                      <div style={{ display: "flex", gap: 7 }}>
                        <div
                          style={{
                            width: 34,
                            height: 9,
                            borderRadius: 4.5,
                            backgroundColor: block.accent,
                          }}
                        />
                        <div
                          style={{
                            width: 14,
                            height: 9,
                            borderRadius: 4.5,
                            backgroundColor: block.accent,
                            opacity: 0.55,
                          }}
                        />
                      </div>
                      <div
                        style={{
                          width: 14,
                          height: 14,
                          borderRadius: 3.5,
                          backgroundColor: block.accent,
                        }}
                      />
                    </div>
                  );
                })}
              </div>
            );
          })}

          {/* Inter-bay execution bus arrows */}
          {[242, 480].map((arrowLeft, idx) => (
            <svg
              key={idx}
              width={40}
              height={30}
              viewBox="0 0 36 28"
              style={{
                position: "absolute",
                left: arrowLeft,
                top: "50%",
                transform: "translateY(-50%)",
              }}
            >
              <path
                d="M 2 14 L 26 14 M 20 7 L 28 14 L 20 21"
                fill="none"
                stroke={
                  busActive > 0.35 ? THEME.colors.cyan : THEME.colors.deskStroke
                }
                strokeWidth={4.5}
                strokeLinecap="round"
                strokeLinejoin="round"
                strokeDasharray={44}
                strokeDashoffset={
                  44 * (1 - clamp01(busActive * 1.2 - idx * 0.2))
                }
              />
            </svg>
          ))}
        </div>
      </div>
    </div>
  );
};

// ============================================================================
// CONTINUOUS DESK -> MATCH-CUT POP-UP ARENA -> TARUHAN HERO WORLD (f0..317)
// Enlarged to fill safe zone (x120..960, y436..1248).
// Continuous beat push-in camera + token tracking pan + whip-pan transitions +
// 120 BPM hit scale punches + spring pop overshoot + dynamic contact shadows.
// Max |rotateY| across all elements = 24deg (<= 30deg target, <= 35deg ceiling).
// ============================================================================
const DeskArenaWorld = () => {
  const frame = useCurrentFrame(); // local 0..317 == global 0..317
  const { fps } = useVideoConfig();

  // --- Phase 1: Token push (f0..44) & 120 BPM Beat 3 slot lock (f45!) ---
  const pushT = clampInterp(frame, [0, 44], [0, 1], THEME.ease.inOutCubic);
  const lockSpring = boundedSpring(
    frame,
    BEATS.tokenLockHit,
    fps,
    THEME.spring.detent,
    12,
  );
  const isLocked = frame >= BEATS.tokenLockHit;

  // --- Phase 2: Telegraph lift (f45..57) & Match-Cut Pop-Up Book Unfold (f58..92) ---
  const edgeLift = clampInterp(frame, [45, 57], [0, 1], THEME.ease.outCubic);
  const unfoldSpring = boundedSpring(frame, 58, fps, THEME.spring.unfold, 32);
  const unfoldClamped = clamp01(unfoldSpring);

  // Match-cut morph frame: expands straight from locked token (286x146) -> unfolded arena (756x758)
  const matchCutT = clampInterp(frame, [58, 78], [0, 1], THEME.ease.popUp);
  const matchCutActive = frame >= 57 && frame <= 80;

  // --- Phase 3: Arena circuit rails draw on Beat 6 (f90..118) ---
  const railDraw = clampInterp(frame, [90, 118], [0, 1], THEME.ease.outCubic);

  // --- Phase 4: TARUHAN hero compression & dolly push-in (f240..260), PARKED f262..304 ---
  const stakesPush = clampInterp(frame, [240, 260], [0, 1], THEME.ease.popUp);

  // --- Phase 5: Fast whip-pan exit left (f308..317) clearing stage before PUNCHLINE settles ---
  const arenaExit = clampInterp(frame, [308, 317], [0, 1], THEME.ease.inCubic);
  const worldOpacity = clampInterp(frame, [310, 317], [1, 0], THEME.ease.inCubic);

  // --- 120 BPM Beat Camera Micro-Punches (all settle to exact 0 well before holds!) ---
  const hitCameraPunch =
    beatPunch(frame, BEATS.tokenLockHit, 0.022) + // f45 token lock
    beatPunch(frame, BEATS.solverHit, 0.016) + // f150 SOLVER land
    beatPunch(frame, BEATS.csvHit, 0.016) + // f180 CSV land
    beatPunch(frame, BEATS.vmHit, 0.014) + // f210 TINY VM land
    beatPunch(frame, BEATS.stakesLandHit, 0.02); // f255 $500 land (exact 0 by f261 <= f262!)

  // --- Continuous Per-Beat Camera Rig (dolly push-in, park on reads, pan follows token/modules) ---
  let baseCamScale = 1;
  let baseCamX = 0;
  let baseCamY = 0;

  if (frame < 60) {
    // HOOK: pan follows token push (+24 -> 0), gentle push-in f0..30 then PARK f30..44 while reading
    baseCamScale = clampInterp(frame, [0, 30], [0.97, 1.005], THEME.ease.outCubic);
    baseCamX = clampInterp(frame, [0, 44], [24, 0], THEME.ease.inOutCubic);
    baseCamY = 0;
  } else if (frame < 135) {
    // META: match-cut bloom push-in f60..105, then PARK f105..131
    baseCamScale = clampInterp(frame, [60, 105], [0.94, 1.018], THEME.ease.popUp);
    baseCamX = 0;
    baseCamY = clampInterp(frame, [60, 96], [10, 0], THEME.ease.outCubic);
  } else if (frame < 240) {
    // ARENA: stepped beat push-in & subtle module-tracking pan, PARKING during every read hold
    const s1 = clampInterp(frame, [135, 152], [0.98, 1.0], THEME.ease.outCubic);
    const s2 = clampInterp(frame, [172, 182], [0, 0.012], THEME.ease.inOutCubic);
    const s3 = clampInterp(frame, [202, 212], [0, 0.012], THEME.ease.inOutCubic);
    baseCamScale = s1 + s2 + s3; // 0.98 -> 1.00 -> 1.012 -> 1.024

    const pToSolver = clampInterp(frame, [138, 152], [0, 8], THEME.ease.outCubic);
    const pToCsv = clampInterp(frame, [172, 182], [0, -16], THEME.ease.inOutCubic);
    const pToVm = clampInterp(frame, [202, 212], [0, 8], THEME.ease.inOutCubic);
    baseCamX = pToSolver + pToCsv + pToVm; // 0 -> +8 -> -8 -> 0

    const yToTop = clampInterp(frame, [138, 152], [0, 6], THEME.ease.outCubic);
    const yToBottom = clampInterp(frame, [202, 212], [0, -12], THEME.ease.inOutCubic);
    baseCamY = yToTop + yToBottom; // 0 -> +6 -> -6
  } else {
    // TARUHAN: hero push-in f240..260, then 100% PARKED f262..304
    baseCamScale = clampInterp(frame, [240, 260], [0.96, 1.022], THEME.ease.popUp);
    baseCamX = 0;
    baseCamY = 0;
  }

  // --- Short Whip-Pan Impulses at Beat Boundaries (zero blur on f0, hits, & reads!) ---
  const whipHookMeta =
    frame >= 55 && frame <= 62
      ? Math.sin(clampInterp(frame, [55, 62], [0, Math.PI]))
      : 0;
  const whipMetaArena =
    frame >= 132 && frame <= 138
      ? Math.sin(clampInterp(frame, [132, 138], [0, Math.PI]))
      : 0;
  const whipArenaStakes =
    frame >= 237 && frame <= 243
      ? Math.sin(clampInterp(frame, [237, 243], [0, Math.PI]))
      : 0;

  const whipOffsetX =
    (frame >= 55 && frame < 59
      ? -whipHookMeta * 38
      : frame >= 59 && frame <= 62
        ? whipHookMeta * 42
        : 0) -
    arenaExit * 660;
  const whipOffsetY =
    (frame >= 132 && frame < 135
      ? -whipMetaArena * 28
      : frame >= 135 && frame <= 138
        ? whipMetaArena * 26
        : 0) +
    (frame >= 237 && frame < 240
      ? whipArenaStakes * 30
      : frame >= 240 && frame <= 243
        ? -whipArenaStakes * 26
        : 0);

  const whipBlur =
    whipHookMeta * 5.5 +
    whipMetaArena * 5 +
    whipArenaStakes * 5 +
    arenaExit * 10;

  const finalCamScale = baseCamScale + hitCameraPunch - arenaExit * 0.04;
  const finalCamX = baseCamX + whipOffsetX;
  const finalCamY = baseCamY + whipOffsetY;

  // --- Desk orientation & enlarged geometry (strictly |rotateY| <= 24deg!) ---
  const deskRotateX =
    18 - unfoldClamped * 13 - stakesPush * 1 + arenaExit * 8; // 18 -> 5 -> 4
  const deskRotateY =
    -10 + pushT * 5 + unfoldClamped * 5 - stakesPush * 4; // -10 -> -5 -> 0 -> -4 (max 10deg!)

  // Enlarged tabletop fills safe zone: HOOK (y830..1212), META/ARENA (y456..1214), TARUHAN (y716..1208)
  const deskBaseTop =
    830 - unfoldSpring * 374 + stakesPush * 260;
  const deskBaseHeight =
    382 + unfoldSpring * 376 - stakesPush * 266;

  // Pop-up book side wings (clamped strictly |rotateY| <= 24deg!)
  const wingSlide = edgeLift * 10 + unfoldSpring * 32;
  const leftWingYaw = clamp(24 - edgeLift * 4 - unfoldSpring * 15, 5, 24);
  const rightWingYaw = -leftWingYaw;

  // Desk dynamic ground shadow grows as pop-up deck unfolds
  const deskShadowBlur = 18 + unfoldClamped * 12;
  const deskShadowAlpha = 0.14 - unfoldClamped * 0.03;

  // --- Token continuous coordinates across ALL beats ---
  const tokenStartX = 304;
  const tokenLockedX = 540;
  const tokenX =
    tokenStartX +
    pushT * (tokenLockedX - tokenStartX) +
    (isLocked ? (1 - lockSpring) * -14 : 0);

  // HOOK y=1021 -> META/ARENA hub y=842 -> TARUHAN hero foreground y=916
  const tokenY =
    1021 - unfoldSpring * 179 + stakesPush * 74;

  const tokenScale =
    1 +
    beatPunch(frame, BEATS.tokenLockHit, 0.085) +
    beatPunch(frame, 90, 0.04) +
    beatPunch(frame, BEATS.stakesLandHit, 0.05) +
    stakesPush * 0.08;

  const tokenRotateY = deskRotateY * (1 - stakesPush) + stakesPush * -7; // max 10deg
  const tokenRotateX = (1 - unfoldClamped) * 7 * (1 - stakesPush);

  // Tactile elevation: elevated during slide, slams flush on f45 lock, floats forward in TARUHAN
  const lockSlamDip = isLocked
    ? clampInterp(frame, [45, 54], [1, 0], THEME.ease.outCubic) * 8
    : 0;
  const tokenElevation =
    (isLocked ? 5 : 13) -
    lockSlamDip +
    unfoldClamped * 6 +
    stakesPush * 20;

  // --- Uniform smooth mascot cross-fades on identical #FFFFFF bed (hidden in whip peaks -> zero flash) ---
  const toPlayCross = clampInterp(frame, [133, 138], [0, 1], THEME.ease.outCubic);
  const toFullCross = clampInterp(frame, [238, 243], [0, 1], THEME.ease.outCubic);
  const happyOpacity = 1 - toPlayCross;
  const playOpacity = toPlayCross * (1 - toFullCross);
  const fullOpacity = toFullCross;

  // --- Lock confirmation shockwave ring on Beat 3 (f45..64) ---
  const lockPulseT = clampInterp(
    frame,
    [BEATS.tokenLockHit, BEATS.tokenLockHit + 18],
    [0, 1],
    THEME.ease.outCubic,
  );

  // --- Module spring pop overshoot entrances synced to 120 BPM hits (f150 / f180 / f210) ---
  // 1) SOLVER: launches f146, LANDS & PUNCHES ON f150 (Beat 10), straightens 0deg for read, fans +11deg in TARUHAN
  const solverPop = boundedSpring(frame, 146, fps, THEME.spring.modulePop, 12);
  const solverRotT = clampInterp(frame, [146, 151], [0, 1], THEME.ease.outCubic);
  const solverX =
    160 + (1 - solverPop) * -210 + stakesPush * 12;
  const solverY =
    458 + stakesPush * 220; // ARENA 458 -> TARUHAN center ~828 (top ~705, clear below "$500 PRIZE POOL")
  const solverScale =
    0.72 +
    solverPop * 0.28 +
    beatPunch(frame, BEATS.solverHit, 0.03) -
    stakesPush * 0.18; // 1.00 in ARENA -> 0.82 in TARUHAN
  const solverLift =
    Math.sin(clampInterp(frame, [146, 152], [0, Math.PI])) * 26 +
    beatPunch(frame, BEATS.solverHit, 8);
  const solverRotateY = clamp(
    (1 - solverRotT) * 24 + stakesPush * 11,
    0,
    24,
  ); // 24deg -> 0deg (straight read!) -> 11deg

  // 2) CSV: launches f176, LANDS & PUNCHES ON f180 (Beat 12), straightens 0deg for read, fans -11deg in TARUHAN
  const csvPop = boundedSpring(frame, 176, fps, THEME.spring.modulePop, 12);
  const csvRotT = clampInterp(frame, [176, 181], [0, 1], THEME.ease.outCubic);
  const csvX =
    548 + (1 - csvPop) * 210 - stakesPush * 12;
  const csvY = 458 + stakesPush * 220;
  const csvScale =
    0.72 +
    csvPop * 0.28 +
    beatPunch(frame, BEATS.csvHit, 0.03) -
    stakesPush * 0.18;
  const csvLift =
    Math.sin(clampInterp(frame, [176, 182], [0, Math.PI])) * 26 +
    beatPunch(frame, BEATS.csvHit, 8);
  const csvRotateY = clamp(
    (1 - csvRotT) * -24 - stakesPush * 11,
    -24,
    0,
  ); // -24deg -> 0deg (straight read!) -> -11deg

  // 3) TINY VM: launches f206, LANDS & PUNCHES ON f210 (Beat 14), straightens 0deg for read
  const vmPop = boundedSpring(frame, 206, fps, THEME.spring.modulePop, 12);
  const vmRotT = clampInterp(frame, [206, 211], [0, 1], THEME.ease.outCubic);
  const vmX = 160;
  const vmY =
    924 + (1 - vmPop) * 190 + stakesPush * 39; // ARENA 924..1218 -> TARUHAN visual 995..1224
  const vmScale =
    0.8 +
    vmPop * 0.2 +
    beatPunch(frame, BEATS.vmHit, 0.025) -
    stakesPush * 0.22; // 1.00 in ARENA -> 0.78 in TARUHAN
  const vmLift =
    Math.sin(clampInterp(frame, [206, 212], [0, Math.PI])) * 24 +
    beatPunch(frame, BEATS.vmHit, 8);
  const vmRotateX = clamp((1 - vmRotT) * 18, 0, 18);

  // --- Parallax layer offsets during TARUHAN hero push-in (f240..260, parked f262..304) ---
  const bgParallaxScale = 1 + stakesPush * 0.03;
  const bgParallaxY = stakesPush * 10;
  const midParallaxScale = 1 + stakesPush * 0.015;
  const fgBracketParallax = stakesPush * 20;

  // Match-cut morph frame dimensions (token 286x146 @ y1021 -> arena 756x758 @ y835)
  const morphW = 286 + matchCutT * (756 - 286);
  const morphH = 146 + matchCutT * (758 - 146);
  const morphCenterY = 1021 + matchCutT * (835 - 1021);
  const morphRadius = 18 + matchCutT * 12;
  const morphOpacity = Math.sin(matchCutT * Math.PI) * 0.92;

  return (
    <AbsoluteFill
      style={{
        opacity: worldOpacity,
        transform: `translate(${finalCamX.toFixed(2)}px, ${finalCamY.toFixed(2)}px) scale(${finalCamScale.toFixed(4)})`,
        transformOrigin: "540px 840px",
        filter: whipBlur > 0.2 ? `blur(${whipBlur.toFixed(1)}px)` : undefined,
      }}
    >
      {/* LAYER 1 (BACKGROUND DEPTH, 0.4x PARALLAX): ENLARGED POP-UP DESK & HINGED WINGS */}
      <div
        style={{
          position: "absolute",
          inset: 0,
          transform: `translateY(${bgParallaxY.toFixed(1)}px) scale(${bgParallaxScale.toFixed(4)})`,
          transformOrigin: "540px 840px",
        }}
      >
        {/* Dynamic ground shadow expanding with pop-up desk unfold */}
        <div
          style={{
            position: "absolute",
            left: 162 - wingSlide * 0.3,
            top: deskBaseTop + 30,
            width: 756 + wingSlide * 0.6,
            height: deskBaseHeight - 6,
            borderRadius: 36,
            backgroundColor: `rgba(25,20,25,${deskShadowAlpha.toFixed(3)})`,
            filter: `blur(${deskShadowBlur.toFixed(1)}px)`,
          }}
        />

        {/* Left Pop-Up Desk Wing (hinges outward with spring overshoot, |rotateY| <= 24deg) */}
        <div
          style={{
            position: "absolute",
            left: 162 - wingSlide * 0.55,
            top: deskBaseTop + 34,
            width: 146,
            height: deskBaseHeight - 68,
            borderRadius: "24px 8px 8px 24px",
            backgroundColor: THEME.colors.deskSide,
            border: `3.5px solid ${THEME.colors.ink}`,
            transform: `perspective(1400px) rotateX(${deskRotateX.toFixed(2)}deg) rotateY(${leftWingYaw.toFixed(2)}deg)`,
            transformOrigin: "100% 50%",
            opacity: 0.35 + edgeLift * 0.45 + unfoldClamped * 0.2,
            boxShadow: "inset -10px 0 18px rgba(25,20,25,0.08)",
          }}
        />

        {/* Right Pop-Up Desk Wing (hinges outward with spring overshoot, |rotateY| <= 24deg) */}
        <div
          style={{
            position: "absolute",
            right: 162 - wingSlide * 0.55,
            top: deskBaseTop + 34,
            width: 146,
            height: deskBaseHeight - 68,
            borderRadius: "8px 24px 24px 8px",
            backgroundColor: THEME.colors.deskSide,
            border: `3.5px solid ${THEME.colors.ink}`,
            transform: `perspective(1400px) rotateX(${deskRotateX.toFixed(2)}deg) rotateY(${rightWingYaw.toFixed(2)}deg)`,
            transformOrigin: "0% 50%",
            opacity: 0.35 + edgeLift * 0.45 + unfoldClamped * 0.2,
            boxShadow: "inset 10px 0 18px rgba(25,20,25,0.08)",
          }}
        />

        {/* Primary Enlarged Desk Tabletop & Pop-Up Book Arena Deck */}
        <div
          style={{
            position: "absolute",
            left: 162,
            top: deskBaseTop,
            width: 756,
            height: deskBaseHeight,
            borderRadius: 30,
            backgroundColor: THEME.colors.deskTop,
            border: `3.5px solid ${THEME.colors.ink}`,
            boxShadow:
              "0 14px 0 #DDD4E8, 0 28px 46px rgba(25,20,25,0.12)",
            transform: `perspective(1400px) rotateX(${deskRotateX.toFixed(2)}deg) rotateY(${deskRotateY.toFixed(2)}deg)`,
            transformOrigin: "50% 55%",
            overflow: "hidden",
          }}
        >
          {/* Pop-up book central fold creases */}
          <div
            style={{
              position: "absolute",
              left: 0,
              right: 0,
              top: "50%",
              height: 2,
              backgroundColor: THEME.colors.deskStroke,
              opacity: 0.78,
            }}
          />
          <div
            style={{
              position: "absolute",
              left: "50%",
              top: 0,
              bottom: 0,
              width: 2,
              backgroundColor: THEME.colors.deskStroke,
              opacity: 0.35 + unfoldClamped * 0.38,
            }}
          />

          {/* Pop-up paper-engineering triangular corner struts */}
          <svg
            width={756}
            height={760}
            viewBox="0 0 756 760"
            style={{
              position: "absolute",
              inset: 0,
              opacity: unfoldClamped * 0.92,
            }}
          >
            <polygon
              points={`26,26 ${26 + unfoldClamped * 116},26 26,${26 + unfoldClamped * 98}`}
              fill={THEME.colors.magentaSoft}
              stroke={THEME.colors.magenta}
              strokeWidth={2}
              strokeOpacity={0.38}
            />
            <polygon
              points={`730,26 ${730 - unfoldClamped * 116},26 730,${26 + unfoldClamped * 98}`}
              fill={THEME.colors.cyanSoft}
              stroke={THEME.colors.cyan}
              strokeWidth={2}
              strokeOpacity={0.48}
            />
          </svg>

          {/* Horizontal token guide track on closed desk surface */}
          <div
            style={{
              position: "absolute",
              left: 52,
              top: "50%",
              transform: "translateY(-50%)",
              width: 392,
              height: 52,
              borderRadius: 14,
              backgroundColor: THEME.colors.deskRecess,
              border: `2px solid ${THEME.colors.deskStroke}`,
              opacity: 1 - unfoldClamped * 0.85,
            }}
          />

          {/* Recessed chamfered make.fun dock slot (pure brand geometry, zero extra text) */}
          <div
            style={{
              position: "absolute",
              left: "50%",
              top: "50%",
              width: 314,
              height: 170,
              transform: "translate(-50%, -50%)",
              borderRadius: 22,
              backgroundColor: isLocked
                ? THEME.colors.cyanSoft
                : THEME.colors.deskRecess,
              border: `3.5px solid ${isLocked ? THEME.colors.cyan : THEME.colors.magenta}`,
              boxShadow: "inset 0 6px 14px rgba(25,20,25,0.12)",
            }}
          >
            <div
              style={{
                position: "absolute",
                right: 11,
                top: 40,
                width: 13,
                height: 84,
                borderRadius: 6,
                backgroundColor: isLocked
                  ? THEME.colors.cyan
                  : THEME.colors.magenta,
              }}
            />
            {[
              { left: 13, top: 11 },
              { right: 13, top: 11 },
              { left: 13, bottom: 11 },
              { right: 13, bottom: 11 },
            ].map((pos, i) => (
              <div
                key={i}
                style={{
                  position: "absolute",
                  ...pos,
                  width: 10,
                  height: 10,
                  borderRadius: 3,
                  backgroundColor: isLocked
                    ? THEME.colors.cyan
                    : THEME.colors.deskStroke,
                }}
              />
            ))}
          </div>

          {/* Lock confirmation shockwave ring on 120 BPM Beat 3 (f45..63) */}
          {frame >= BEATS.tokenLockHit && frame <= BEATS.tokenLockHit + 20 && (
            <div
              style={{
                position: "absolute",
                left: "50%",
                top: "50%",
                width: 296,
                height: 162,
                borderRadius: 26,
                border: `4.5px solid ${THEME.colors.cyan}`,
                transform: `translate(-50%, -50%) scale(${(0.95 + lockPulseT * 1.15).toFixed(4)})`,
                opacity: clamp01(1 - lockPulseT),
              }}
            />
          )}
        </div>

        {/* MATCH-CUT TOKEN -> ARENA EXPANDING FRAME (f57..80):
            Morphs directly from locked token outline (286x146) into full Arena deck (756x758) */}
        {matchCutActive && morphOpacity > 0.01 && (
          <div
            style={{
              position: "absolute",
              left: 540 - morphW / 2,
              top: morphCenterY - morphH / 2,
              width: morphW,
              height: morphH,
              borderRadius: morphRadius,
              border: `5px solid ${THEME.colors.magenta}`,
              boxShadow: `0 0 0 3px ${THEME.colors.cyan}`,
              opacity: morphOpacity,
              pointerEvents: "none",
            }}
          />
        )}

        {/* Circuit/Track Rails drawing outward from locked token hub to 3 module sockets */}
        {railDraw > 0.01 && (
          <svg
            width={1080}
            height={1920}
            viewBox="0 0 1080 1920"
            style={{
              position: "absolute",
              inset: 0,
              opacity: clamp01(railDraw) * (1 - stakesPush * 0.3),
              pointerEvents: "none",
            }}
          >
            {/* Rail to SOLVER */}
            <path
              d="M 440 806 L 346 806 L 346 756"
              fill="none"
              stroke={THEME.colors.magenta}
              strokeWidth={6.5}
              strokeLinecap="round"
              strokeLinejoin="round"
              strokeDasharray={170}
              strokeDashoffset={170 * (1 - railDraw)}
            />
            {/* Rail to CSV */}
            <path
              d="M 640 806 L 734 806 L 734 756"
              fill="none"
              stroke={THEME.colors.cyan}
              strokeWidth={6.5}
              strokeLinecap="round"
              strokeLinejoin="round"
              strokeDasharray={170}
              strokeDashoffset={170 * (1 - railDraw)}
            />
            {/* Dual Bus Rail to TINY VM */}
            <path
              d="M 498 906 L 498 932 M 582 906 L 582 932"
              fill="none"
              stroke={THEME.colors.ink}
              strokeWidth={5.5}
              strokeLinecap="round"
              strokeDasharray={64}
              strokeDashoffset={64 * (1 - railDraw)}
            />
          </svg>
        )}
      </div>

      {/* LAYER 2 (MIDGROUND DEPTH, 0.75x PARALLAX): THREE ENLARGED MISSION MODULES */}
      {frame >= 146 && (
        <div
          style={{
            position: "absolute",
            inset: 0,
            transform: `scale(${midParallaxScale.toFixed(4)})`,
            transformOrigin: "540px 840px",
          }}
        >
          <SolverModule
            frame={frame}
            fps={fps}
            left={solverX}
            top={solverY}
            scale={solverScale}
            lift={solverLift}
            rotateY={solverRotateY}
            opacity={clamp01(solverPop * 1.8)}
          />
          {frame >= 176 && (
            <CsvModule
              frame={frame}
              fps={fps}
              left={csvX}
              top={csvY}
              scale={csvScale}
              lift={csvLift}
              rotateY={csvRotateY}
              opacity={clamp01(csvPop * 1.8)}
            />
          )}
          {frame >= 206 && (
            <TinyVmModule
              frame={frame}
              fps={fps}
              left={vmX}
              top={vmY}
              scale={vmScale}
              lift={vmLift}
              rotateX={vmRotateX}
              opacity={clamp01(vmPop * 1.8)}
            />
          )}
        </div>
      )}

      {/* LAYER 3 (FOREGROUND DEPTH, 1.15x PARALLAX): CONTINUOUS "AI AGENT" TOKEN & HAND */}
      <AgentToken
        x={tokenX}
        y={tokenY}
        scale={tokenScale}
        rotateY={tokenRotateY}
        rotateX={tokenRotateX}
        elevation={tokenElevation}
        isLocked={isLocked}
        happyOpacity={happyOpacity}
        playOpacity={playOpacity}
        fullOpacity={fullOpacity}
      />

      <PushingHand
        tokenLeftX={tokenX - 143}
        tokenCenterY={tokenY}
        frame={frame}
      />

      {/* Foreground depth corner framing brackets during TARUHAN hero dolly */}
      {stakesPush > 0.02 && (
        <div
          style={{
            position: "absolute",
            inset: 0,
            opacity: stakesPush * 0.9,
            pointerEvents: "none",
          }}
        >
          <div
            style={{
              position: "absolute",
              left: 146 - fgBracketParallax * 0.35,
              top: 702 - fgBracketParallax * 0.2,
              width: 36,
              height: 36,
              borderTop: `5px solid ${THEME.colors.magenta}`,
              borderLeft: `5px solid ${THEME.colors.magenta}`,
              borderTopLeftRadius: 8,
            }}
          />
          <div
            style={{
              position: "absolute",
              right: 146 - fgBracketParallax * 0.35,
              top: 1188 + fgBracketParallax * 0.2,
              width: 36,
              height: 36,
              borderBottom: `5px solid ${THEME.colors.cyan}`,
              borderRight: `5px solid ${THEME.colors.cyan}`,
              borderBottomRightRadius: 8,
            }}
          />
        </div>
      )}
    </AbsoluteFill>
  );
};

// ============================================================================
// TARUHAN HEADLINE (f240..314) — "$500 PRIZE POOL"
// Separate camera-facing blockbuster headline (not a balance/payout UI).
// Word-by-word blur->sharp + slide + spring punch:
//   "$500" LANDS SHARP & PUNCHES RIGHT ON 120 BPM BEAT f255!
//   "PRIZE" & "POOL" lock completely sharp & dead-still by global f262 (<= f262!).
// Safe zone x124..956, y434..686 (clear below badge y424 and above TARUHAN arena).
// ============================================================================
const StakesHeadline = () => {
  const frame = useCurrentFrame(); // local 0..74 == global 240..314
  const { fps } = useVideoConfig();

  const words = COPY.stakes.split(" "); // ["$500", "PRIZE", "POOL"]
  const amountWord = words[0]; // "$500"
  const prizeWord = words[1]; // "PRIZE"
  const poolWord = words[2]; // "POOL"

  // Global f255 == local f15 -> "$500" launches local 11, hits blur=0 & peak punch at local 15 (global f255)!
  const landBeatPunch = beatPunch(frame, 15, 0.05);
  const barProgress = clampInterp(
    frame,
    [15, 21],
    [0, 1],
    THEME.ease.outCubic,
  );

  // Fast whip-pan exit left local f68..74 (global f308..314)
  const exitT = clampInterp(frame, [68, 74], [0, 1], THEME.ease.inCubic);
  const exitX = exitT * -480;
  const exitBlur = exitT * 9;
  const opacity = clampInterp(frame, [69, 74], [1, 0], THEME.ease.inCubic);

  return (
    <div
      style={{
        position: "absolute",
        left: 124,
        top: 434,
        width: 832,
        opacity,
        transform: `translateX(${exitX.toFixed(1)}px)`,
        filter: exitBlur > 0.2 ? `blur(${exitBlur.toFixed(1)}px)` : undefined,
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        textAlign: "center",
      }}
    >
      {/* Line 1: "$500" — HUGE magenta focal punch landing on f255 (local 15) */}
      <div style={{ display: "flex", justifyContent: "center" }}>
        <KineticWord
          frame={frame}
          fps={fps}
          start={11}
          settleDuration={8}
          blurDuration={4}
          blurFrom={16}
          slideY={48}
          scaleFrom={0.58}
          extraPunch={landBeatPunch}
          style={{
            fontSize: 144,
            fontWeight: 900,
            lineHeight: 0.94,
            letterSpacing: "-0.045em",
            color: THEME.colors.magenta,
          }}
        >
          <span style={{ fontVariantNumeric: "tabular-nums" }}>{amountWord}</span>
        </KineticWord>
      </div>

      {/* Line 2: "PRIZE POOL" — word-by-word, settled 100% sharp & still at global f262 (local 22) */}
      <div
        style={{
          display: "flex",
          justifyContent: "center",
          alignItems: "baseline",
          columnGap: 24,
          marginTop: 2,
        }}
      >
        <KineticWord
          frame={frame}
          fps={fps}
          start={13}
          settleDuration={7}
          blurDuration={4}
          blurFrom={14}
          slideY={40}
          scaleFrom={0.68}
          style={{
            fontSize: 108,
            fontWeight: 900,
            lineHeight: 0.95,
            letterSpacing: "-0.04em",
            color: THEME.colors.ink,
          }}
        >
          {prizeWord}
        </KineticWord>
        <KineticWord
          frame={frame}
          fps={fps}
          start={15}
          settleDuration={7}
          blurDuration={4}
          blurFrom={14}
          slideY={40}
          scaleFrom={0.68}
          style={{
            fontSize: 108,
            fontWeight: 900,
            lineHeight: 0.95,
            letterSpacing: "-0.04em",
            color: THEME.colors.ink,
          }}
        >
          {poolWord}
        </KineticWord>
      </div>

      {/* Precision brand divider rule — settled completely by local f21 (global f261 <= f262) */}
      <div
        style={{
          marginTop: 12,
          width: 310,
          height: 7,
          borderRadius: 4,
          background: `linear-gradient(90deg, ${THEME.colors.magenta} 0%, ${THEME.colors.cyan} 100%)`,
          transform: `scaleX(${barProgress.toFixed(4)})`,
          transformOrigin: "50% 50%",
        }}
      />
    </div>
  );
};

// ============================================================================
// PUNCHLINE (f315..374) — "Enter your AI agent on make.fun."
// Arena completely stopped & unmounted before words finish; zero competing labels.
// Word-by-word blur->sharp + slide + spring scale punch filling safe-zone width.
// ALL 6 words settle to exact rest at local f14 (global f329) ->
// 100% DEAD-STILL & RAZOR-SHARP across ALL of global f330..374!
// Safe zone x124..956, y618..1048.
// ============================================================================
const PunchlineBeat = () => {
  const frame = useCurrentFrame(); // local 0..59 == global 315..374
  const { fps } = useVideoConfig();

  const words = COPY.punchline.split(" "); // ["Enter", "your", "AI", "agent", "on", "make.fun."]
  const brandWordRaw = words[5]; // "make.fun."
  const brandCore = brandWordRaw.slice(0, brandWordRaw.length - 1); // "make.fun"
  const brandDot = brandWordRaw.slice(brandWordRaw.length - 1); // "."

  // Horizon bar & subtle brand halo finish by local f14 (global f329) -> frozen f330..374
  const horizonScale = clampInterp(frame, [6, 14], [0, 1], THEME.ease.outCubic);
  const brandGlow = clampInterp(frame, [7, 14], [0, 0.22], THEME.ease.outCubic);

  return (
    <div
      style={{
        position: "absolute",
        left: 124,
        top: 620,
        width: 832,
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        textAlign: "center",
        gap: 8,
      }}
    >
      {/* Line 1: "Enter your" (starts local 0 & 1, settled by local 8) */}
      <div
        style={{
          display: "flex",
          justifyContent: "center",
          alignItems: "baseline",
          columnGap: 24,
        }}
      >
        <KineticWord
          frame={frame}
          fps={fps}
          start={0}
          settleDuration={7}
          blurDuration={4}
          blurFrom={14}
          slideY={40}
          scaleFrom={0.68}
          style={{
            fontSize: 112,
            fontWeight: 800,
            lineHeight: 0.98,
            letterSpacing: "-0.04em",
            color: THEME.colors.ink,
          }}
        >
          {words[0]}
        </KineticWord>
        <KineticWord
          frame={frame}
          fps={fps}
          start={1}
          settleDuration={7}
          blurDuration={4}
          blurFrom={14}
          slideY={40}
          scaleFrom={0.68}
          style={{
            fontSize: 112,
            fontWeight: 800,
            lineHeight: 0.98,
            letterSpacing: "-0.04em",
            color: THEME.colors.ink,
          }}
        >
          {words[1]}
        </KineticWord>
      </div>

      {/* Line 2: "AI agent" (starts local 3 & 5, settled by local 12) */}
      <div
        style={{
          display: "flex",
          justifyContent: "center",
          alignItems: "baseline",
          columnGap: 24,
        }}
      >
        <KineticWord
          frame={frame}
          fps={fps}
          start={3}
          settleDuration={7}
          blurDuration={4}
          blurFrom={14}
          slideY={44}
          scaleFrom={0.66}
          style={{
            fontSize: 140,
            fontWeight: 900,
            lineHeight: 0.98,
            letterSpacing: "-0.045em",
            color: THEME.colors.ink,
          }}
        >
          {words[2]}
        </KineticWord>
        <KineticWord
          frame={frame}
          fps={fps}
          start={5}
          settleDuration={7}
          blurDuration={4}
          blurFrom={14}
          slideY={44}
          scaleFrom={0.66}
          style={{
            fontSize: 140,
            fontWeight: 900,
            lineHeight: 0.98,
            letterSpacing: "-0.045em",
            color: THEME.colors.ink,
          }}
        >
          {words[3]}
        </KineticWord>
      </div>

      {/* Line 3: "on make.fun." (starts local 6 & 7, settled 100% by local 14 == global f329!) */}
      <div
        style={{
          display: "flex",
          justifyContent: "center",
          alignItems: "baseline",
          columnGap: 20,
        }}
      >
        <KineticWord
          frame={frame}
          fps={fps}
          start={6}
          settleDuration={7}
          blurDuration={4}
          blurFrom={14}
          slideY={40}
          scaleFrom={0.68}
          style={{
            fontSize: 118,
            fontWeight: 800,
            lineHeight: 1.0,
            letterSpacing: "-0.04em",
            color: THEME.colors.ink,
          }}
        >
          {words[4]}
        </KineticWord>

        <KineticWord
          frame={frame}
          fps={fps}
          start={7}
          settleDuration={7}
          blurDuration={4}
          blurFrom={16}
          slideY={44}
          scaleFrom={0.64}
          style={{
            fontSize: 120,
            fontWeight: 900,
            lineHeight: 1.0,
            letterSpacing: "-0.04em",
          }}
        >
          <span
            style={{
              position: "absolute",
              left: -22,
              right: -14,
              top: -10,
              bottom: -10,
              borderRadius: 999,
              background: `radial-gradient(ellipse at center, rgba(196,28,131,${brandGlow.toFixed(3)}) 0%, rgba(196,28,131,0) 72%)`,
              pointerEvents: "none",
            }}
          />
          <span style={{ position: "relative", color: THEME.colors.magenta }}>
            {brandCore}
          </span>
          <span style={{ position: "relative", color: THEME.colors.ink }}>
            {brandDot}
          </span>
        </KineticWord>
      </div>

      {/* Minimal static studio horizon accent (100% frozen from global f329..374) */}
      <div
        style={{
          marginTop: 34,
          width: 176,
          height: 6,
          borderRadius: 3,
          background: `linear-gradient(90deg, ${THEME.colors.magenta} 0%, ${THEME.colors.cyan} 100%)`,
          transform: `scaleX(${horizonScale.toFixed(4)})`,
          transformOrigin: "50% 50%",
        }}
      />
    </div>
  );
};

// ============================================================================
// TENANG CALM END PLATE (f375..449)
// Zero text, zero animation — clean light plate for official ffmpeg end card.
// ============================================================================
const CalmEndPlate = () => {
  return (
    <AbsoluteFill style={{ pointerEvents: "none" }}>
      <div
        style={{
          position: "absolute",
          left: 240,
          right: 240,
          top: 1084,
          height: 2,
          background: `linear-gradient(90deg, transparent 0%, ${THEME.colors.lineHair} 50%, transparent 100%)`,
          opacity: 0.75,
        }}
      />
    </AbsoluteFill>
  );
};

// ============================================================================
// ROOT COMPOSITION COMPONENT: AdDesk (1080x1920, 30fps, 450 frames)
// ============================================================================
export const AdDesk = () => {
  const frame = useCurrentFrame();
  const isCalmPlate = frame >= BEATS.calmStart;

  return (
    <AbsoluteFill
      style={{
        width: 1080,
        height: 1920,
        fontFamily: THEME.font,
        overflow: "hidden",
      }}
    >
      {/* Persistent light studio plate (simplifies & freezes cleanly on PUNCHLINE hold & TENANG) */}
      <StudioBackdrop frame={frame} isCalmPlate={isCalmPlate} />

      {/* Continuous Desk -> Match-Cut Pop-Up Arena -> Taruhan World (unmounts at f318, clear before PUNCHLINE hold) */}
      <Sequence from={0} durationInFrames={318}>
        <DeskArenaWorld />
      </Sequence>

      {/* Short whip-pan speed accents ONLY across beat cuts (f55..62, f132..138, f237..243, f310..317) */}
      <WhipTransitionOverlay />

      {/* Persistent small label "make.fun contest" across active beats f0..374 (absent on TENANG f375..449) */}
      <Sequence from={0} durationInFrames={BEATS.calmStart}>
        <KickerLabel />
      </Sequence>

      {/* Beat 1: HOOK headline (f0..59, frame 0 sharp, word-by-word blur->sharp + slide + punch) */}
      <Sequence from={BEATS.hookStart} durationInFrames={BEATS.hookDuration}>
        <HookHeadline />
      </Sequence>

      {/* Beat 4: TARUHAN headline (f240..314, "$500" lands f255, entire headline sharp & still by f262) */}
      <Sequence from={BEATS.stakesStart} durationInFrames={BEATS.stakesDuration}>
        <StakesHeadline />
      </Sequence>

      {/* Beat 5: PUNCHLINE closing sentence (f315..374, 100% still & razor-sharp f329..374) */}
      <Sequence from={BEATS.punchStart} durationInFrames={BEATS.punchDuration}>
        <PunchlineBeat />
      </Sequence>

      {/* Beat 6: TENANG quiet end plate (f375..449, zero text, zero animation) */}
      <Sequence from={BEATS.calmStart} durationInFrames={BEATS.calmDuration}>
        <CalmEndPlate />
      </Sequence>
    </AbsoluteFill>
  );
};

export default AdDesk;
