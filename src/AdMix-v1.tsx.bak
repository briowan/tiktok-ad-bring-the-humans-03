          height={height}
          dpr={1}
          camera={{ fov: 34, near: 0.1, far: 100 }}
          gl={CANVAS_GL}
          style={{ width: "100%", height: "100%" }}
        >
          {/* Camera level with token at y=+1.55 aimed at y=0 => front-on view projecting to screen y≈554 */}
          <MixCameraRig position={[camX, 1.55, camZ]} target={[0, 0, 0]} fov={34} />
          <FloatingTokenRig frame={frame} />
          <group position={[0, 1.55 + tokenFloatY, 0]}>
            <AgentToken
              frame={frame + 18}
              scale={0.43}
              spin={tokenSpin}
              ringGlow={0.36}
            />
          </group>
        </ThreeCanvas>
      </AbsoluteFill>

      {/* Giant 140px Clean Lockup — 100% sharp & still ("diam+tajam") from f0..44 (x120..960, y696..1138) */}
      <div
        style={{
          position: "absolute",
          left: SAFE.left,
          top: 696,
          width: SAFE.width,
          display: "flex",
          flexDirection: "column",
          alignItems: "center",
          textAlign: "center",
          gap: 6,
        }}
      >
        {lines.map((lineText, idx) => {
          const isDomain = idx === 2; // "make.fun." (always lowercase)
          return (
            <div
              key={idx}
              style={{
                position: "relative",
                display: "inline-block",
                fontFamily: FONT_DISPLAY,
                fontSize: 140,
                fontWeight: 800,
                lineHeight: 0.96,
                letterSpacing: "-0.045em",
                color: isDomain ? COLORS.magenta : COLORS.ink,
                whiteSpace: "nowrap",
              }}
            >
              {lineText}
              {isDomain && (
                <div
                  style={{
                    position: "relative",
                    margin: "14px auto 0",
                    width: `${underlineT * 100}%`,
                    height: 11,
                    borderRadius: 6,
                    backgroundColor: COLORS.magenta,
                    overflow: "hidden",
                    boxShadow: "0 6px 22px rgba(196, 28, 131, 0.3)",
                  }}
                >
                  <div
                    style={{
                      position: "absolute",
                      top: 0,
                      left: sheenLeft,
                      width: 120,
                      height: "100%",
                      background:
                        "linear-gradient(90deg, transparent, rgba(255,255,255,0.75), transparent)",
                    }}
                  />
                </div>
              )}
            </div>
          );
        })}
      </div>
    </AbsoluteFill>
  );
};

// ============================================================================
// TENANG (f375-449, 75f) — Calm StudioBg Plate (Zero Text, Ready for ffmpeg End Card)
// ============================================================================

const Beat8CalmPlate: React.FC = () => {
  const frame = useCurrentFrame();
  const { width, height } = useVideoConfig();

  const driftT = interpolate(frame, [0, 74], [0, 1], {
    easing: EASE_IN_OUT,
    ...CLAMP,
  });
  const camX = -0.65 + driftT * 1.3;
  const camY = 2.3 - driftT * 0.22;
  const camZ = 12.6 - driftT * 0.7;

  return (
    <AbsoluteFill style={{ backgroundColor: COLORS.studioLight, overflow: "hidden" }}>
      <ThreeCanvas
        width={width}
        height={height}
        shadows
        dpr={1}
        camera={{ fov: 34, near: 0.1, far: 100 }}
        gl={CANVAS_GL}
        style={{ width: "100%", height: "100%" }}
      >
        <MixCameraRig position={[camX, camY, camZ]} target={[0, -0.25, 0]} fov={34} />
        <StudioBg frame={frame} tone="light" withLights />
      </ThreeCanvas>
    </AbsoluteFill>
  );
};

// ============================================================================
// Root Composition: AdMix (1080x1920, 30fps, 450 frames)
// ============================================================================

export const AdMix: React.FC = () => {
  return (
    <AbsoluteFill style={{ backgroundColor: COLORS.magenta }}>
      <Sequence from={0} durationInFrames={45} name="B1-KineticType">
        <Beat1KineticType />
      </Sequence>

      <Sequence from={45} durationInFrames={45} name="B2-WordBuild">
        <Beat2WordBuild />
      </Sequence>

      <Sequence from={90} durationInFrames={60} name="B3-Hero3D">
        <Beat3Hero3D />
      </Sequence>

      <Sequence from={150} durationInFrames={60} name="B4-ActionSlot">
        <Beat4ActionSlot />
      </Sequence>

      <Sequence from={210} durationInFrames={60} name="B5-Task3D">
        <Beat5Task3D />
      </Sequence>

      <Sequence from={270} durationInFrames={60} name="B6-TypeCoins">
        <Beat6TypeCoins />
      </Sequence>

      <Sequence from={330} durationInFrames={45} name="B7-CleanLockup">
        <Beat7CleanLockup />
      </Sequence>

      <Sequence from={375} durationInFrames={75} name="B8-CalmEndPlate">
        <Beat8CalmPlate />
      </Sequence>
    </AbsoluteFill>
  );
};

export default AdMix;
