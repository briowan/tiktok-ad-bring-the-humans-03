  // Continuous orbit + push-in framing SlotScene in lower studio stage (y≈920..1620)
  const orbitT = interpolate(frame, [0, 59], [0, 1], {
    easing: EASE_IN_OUT,
    ...CLAMP,
  });
  const lockKick = interpolate(frame, [33, 36, 44], [0, -0.32, 0], {
    easing: EASE_OUT,
    ...CLAMP,
  });
  const camX = -1.75 + orbitT * 3.5;
  const camY = 4.35 - orbitT * 0.48 + lockKick * 0.4;
  const camZ = 14.8 - orbitT * 1.2 + lockKick;

  // Synchronized magenta underline sweeping under "agent." right on the 3D dock lock hit (f33..50)
  const lockUnderline = interpolate(frame, [32, 50], [0, 1], {
    easing: EASE_SNAP,
    ...CLAMP,
  });
  const headDriftY = interpolate(frame, [0, 59], [10, -8], {
    easing: EASE_IN_OUT,
    ...CLAMP,
  });

  return (
    <AbsoluteFill style={{ backgroundColor: COLORS.studioLight, overflow: "hidden" }}>
      {/* Single ThreeCanvas for B4 Action 3D */}
