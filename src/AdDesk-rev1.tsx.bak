  colors: {
    bgTop: "#FFFFFF",
    bgBase: "#FAF8FC",
    bgBottom: "#F1ECF6",
    surface: "#FFFFFF",
    surfaceSoft: "#F5F1F9",
    deskTop: "#F7F4FA",
    deskSide: "#E6DFEE",
    deskRecess: "#EBE5F2",
    deskStroke: "#CFC5DB",
    ink: "#191419",
    inkMuted: "#6F6478",
    magenta: "#c41c83",
    magentaSoft: "#FBEAF4",
    cyan: "#22d3ee",
    cyanSoft: "#E6FAFD",
    lineHair: "#E3DCEB",
  },
  font: 'Arial, "Helvetica Neue", Helvetica, sans-serif',
  ease: {
    outCubic: Easing.out(Easing.cubic),
    inCubic: Easing.in(Easing.cubic),
    inOutCubic: Easing.inOut(Easing.cubic),
    popUp: Easing.bezier(0.22, 1, 0.36, 1),
    snapOut: Easing.out(Easing.back(1.22)),
  },
  spring: {
    snappy: { damping: 14, stiffness: 280, mass: 0.78 },
    punch: { damping: 11.5, stiffness: 360, mass: 0.65 },
    modulePop: { damping: 11.5, stiffness: 340, mass: 0.68 },
