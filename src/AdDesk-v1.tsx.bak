// ============================================================================
// HOOK HEADLINE (f0..59) — "How good is your AI agent?"
// 100% sharp, opaque, crisp at frame 0. Magenta accent on "AI agent".
// Safe zone x132..948, y458..646 (34px clear below badge box y424).
// ============================================================================
const HookHeadline = () => {
  const frame = useCurrentFrame(); // local 0..59 == global 0..59

  const accentIdx = COPY.hook.indexOf(COPY.hookAccent);
  const lineOne = COPY.hook.slice(0, accentIdx).trimEnd(); // "How good is your"
  const accentText = COPY.hook.slice(accentIdx, accentIdx + COPY.hookAccent.length); // "AI agent"
  const trailingPunct = COPY.hook.slice(accentIdx + COPY.hookAccent.length); // "?"

  // Kinetic accent sweep after frame 0 without ever blurring or dimming frame 0
  const underlineProgress = clampInterp(frame, [3, 19], [0, 1], THEME.ease.outCubic);
  const haloOpacity = clampInterp(frame, [0, 14], [0.14, 0.24], THEME.ease.outCubic);

  // Fast crisp exit (10 frames: f50..59) right as desk unfolds
  const exitT = clampInterp(frame, [50, 59], [0, 1], THEME.ease.inCubic);
  const exitY = exitT * -36;
  const exitScale = 1 - exitT * 0.03;
  const opacity = 1 - exitT;

  return (
    <div
      style={{
        position: "absolute",
        left: 132,
        top: 458,
        width: 816,
        opacity,
        transform: `translateY(${exitY}px) scale(${exitScale})`,
        transformOrigin: "50% 40%",
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        textAlign: "center",
      }}
    >
      {/* Line 1 */}
      <div
        style={{
          fontFamily: THEME.font,
          fontSize: 78,
          fontWeight: 800,
          lineHeight: 1.08,
          letterSpacing: "-0.03em",
          color: THEME.colors.ink,
        }}
      >
        {lineOne}
      </div>

      {/* Line 2 with highlighted "AI agent" */}
      <div
        style={{
          position: "relative",
          display: "inline-flex",
          alignItems: "baseline",
          marginTop: 6,
          fontFamily: THEME.font,
          fontSize: 82,
          fontWeight: 900,
          lineHeight: 1.06,
          letterSpacing: "-0.03em",
        }}
      >
        {/* Subtle studio glow behind keyword (inspired by jup ref) */}
        <div
          style={{
            position: "absolute",
            left: -26,
            right: 16,
            top: -12,
            bottom: -14,
            borderRadius: 999,
            background: `radial-gradient(ellipse at center, rgba(196,28,131,${haloOpacity}) 0%, rgba(196,28,131,0) 72%)`,
            pointerEvents: "none",
          }}
        />
        <span style={{ position: "relative", color: THEME.colors.magenta }}>
          {accentText}
          <span
            style={{
              position: "absolute",
              left: 2,
              right: 2,
              bottom: -8,
              height: 7,
              borderRadius: 4,
              background: `linear-gradient(90deg, ${THEME.colors.magenta} 0%, ${THEME.colors.cyan} 100%)`,
              transform: `scaleX(${underlineProgress})`,
              transformOrigin: "0% 50%",
            }}
          />
        </span>
        <span style={{ position: "relative", color: THEME.colors.ink }}>
          {trailingPunct}
        </span>
      </div>
    </div>
  );
};

