            start={2}
            settleDuration={10}
            blurDuration={4}
            blurFrom={14}
            slideY={-22}
            scaleFrom={1.44}
            springConfig={THEME.spring.slam}
            text={amountWord}
            glowOpacity={amountGlow}
            glowColorRgba="34,211,238"
            style={{
              fontSize: 166,
              fontWeight: 900,
              lineHeight: 0.92,
              letterSpacing: "-0.045em",
              color: THEME.colors.white,
              fontVariantNumeric: "tabular-nums",
              textShadow: "0 10px 26px rgba(25,20,25,0.28)",
            }}
          />
        </div>

        {/* Line 2: "PRIZE POOL" — starts global f246 & f248, settled global f258 <= f262 */}
        <div
          style={{
            display: "flex",
            justifyContent: "center",
            alignItems: "baseline",
            columnGap: 24,
            marginTop: 4,
          }}
        >
          <KineticWord
            frame={frame}
            fps={fps}
            start={6}
            settleDuration={10}
            blurDuration={4}
            blurFrom={12}
            slideY={26}
            scaleFrom={1.34}
            springConfig={THEME.spring.slam}
            text={prizeWord}
            style={{
              fontSize: 112,
              fontWeight: 900,
              lineHeight: 0.94,
              letterSpacing: "-0.04em",
              color: THEME.colors.white,
              textShadow: "0 8px 22px rgba(25,20,25,0.24)",
            }}
          />
          <KineticWord
            frame={frame}
            fps={fps}
            start={8}
            settleDuration={10}
            blurDuration={4}
            blurFrom={12}
            slideY={26}
            scaleFrom={1.34}
            springConfig={THEME.spring.slam}
            text={poolWord}
            style={{
              fontSize: 112,
              fontWeight: 900,
              lineHeight: 0.94,
              letterSpacing: "-0.04em",
              color: THEME.colors.white,
              textShadow: "0 8px 22px rgba(25,20,25,0.24)",
            }}
          />
        </div>

        {/* Bright cyan accent rule — locked exact at global f258 <= f262 */}
        <div
          style={{
            marginTop: 14,
            width: 340,
            height: 8,
            borderRadius: 4,
            backgroundColor: THEME.colors.cyan,
            boxShadow: "0 4px 14px rgba(25,20,25,0.22)",
            transform: `scaleX(${barProgress.toFixed(4)})`,
            transformOrigin: "50% 50%",
          }}
        />
      </div>
    </AbsoluteFill>
  );
};

