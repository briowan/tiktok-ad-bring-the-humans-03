  const words = COPY.stakes.split(" "); // ["$500", "PRIZE", "POOL"]
  const amountWord = words[0]; // "$500"
  const prizeWord = words[1]; // "PRIZE"
  const poolWord = words[2]; // "POOL"

  const barProgress = clampInterp(frame, [10, 18], [0, 1], THEME.ease.outCubic);
  const amountGlow = clampInterp(frame, [2, 14], [0, 0.26], THEME.ease.outCubic);
  const outFade = clampInterp(frame, [70, 74], [1, 0], THEME.ease.inCubic);

  return (
    <AbsoluteFill style={{ opacity: outFade, pointerEvents: "none" }}>
      <div
        style={{
          position: "absolute",
          left: 124,
          top: 434,
          width: 832,
          display: "flex",
          flexDirection: "column",
          alignItems: "center",
          textAlign: "center",
        }}
      >
