// ============================================================================
// BEAT 6: TENANG CALM END PLATE (f375..449)
// Zero text, zero animation — calm light studio plate for official ffmpeg end card.
// ============================================================================
const CalmEndPlate = () => {
  return (
    <AbsoluteFill style={{ pointerEvents: "none" }}>
      <div
        style={{
          position: "absolute",
          left: 240,
          right: 240,
          top: 1084,
          height: 2,
          background: `linear-gradient(90deg, transparent 0%, ${THEME.colors.lineHair} 50%, transparent 100%)`,
          opacity: 0.72,
        }}
      />
    </AbsoluteFill>
  );
};

// ============================================================================
// PERSISTENT 3D STAGE WRAPPER (SINGLE <ThreeCanvas> ACROSS f45..314)
// Prevents repeated WebGL context teardown & gives seamless 3D continuity.
// ============================================================================
const Stage3DLayer = () => {
  const localFrame = useCurrentFrame(); // 0..269
  const { fps } = useVideoConfig();
  const globalFrame = BEATS.stage3DStart + localFrame;

  // Clean fade-in at f45..48 and wipe-out hide at f310..314 before PUNCHLINE
  const fadeIn = clampInterp(globalFrame, [45, 48], [0, 1], THEME.ease.outCubic);
  const fadeOut = clampInterp(globalFrame, [310, 314], [1, 0], THEME.ease.inCubic);

  return (
    <AbsoluteFill
      style={{
        opacity: fadeIn * fadeOut,
        pointerEvents: "none",
      }}
    >
      <ThreeCanvas
        width={1080}
        height={1920}
        camera={{ fov: 36, position: [0.75, 1.25, 12.8], near: 0.1, far: 100 }}
        gl={{ alpha: true, antialias: true }}
        style={{
          position: "absolute",
          left: 0,
          top: 0,
          width: 1080,
          height: 1920,
        }}
      >
        <DeskArenaScene3D frame={globalFrame} fps={fps} />
      </ThreeCanvas>
    </AbsoluteFill>
  );
};

// ============================================================================
// ROOT COMPOSITION COMPONENT: AdDesk (1080x1920, 30fps, 450 frames)
// ============================================================================
export const AdDesk = () => {
  const frame = useCurrentFrame();

  return (
    <AbsoluteFill
      style={{
        width: 1080,
        height: 1920,
        fontFamily: THEME.font,
        overflow: "hidden",
      }}
    >
      {/* Layer 1: Bold Jiwa+-style brand color-block backdrop + geometric splashes */}
      <ColorBlockBackdrop frame={frame} />

      {/* Layer 2: Single continuous real-3D Three.js stage (HOOK handoff f45 -> TARUHAN f314) */}
      <Sequence
        from={BEATS.stage3DStart}
        durationInFrames={BEATS.stage3DDuration}
      >
        <Stage3DLayer />
      </Sequence>

      {/* Layer 3: Beat-scoped kinetic HTML typography overlays */}
      <Sequence from={BEATS.hookStart} durationInFrames={BEATS.hookDuration}>
        <HookOverlay />
      </Sequence>

      <Sequence
        from={BEATS.stakesStart}
        durationInFrames={BEATS.stakesDuration}
      >
        <TaruhanOverlay />
      </Sequence>

      <Sequence from={BEATS.punchStart} durationInFrames={BEATS.punchDuration}>
        <PunchlineOverlay />
      </Sequence>

      <Sequence from={BEATS.calmStart} durationInFrames={BEATS.calmDuration}>
        <CalmEndPlate />
      </Sequence>

      {/* Layer 4: Persistent top-right kicker "make.fun contest" (f0..374; absent on TENANG) */}
      <Sequence from={0} durationInFrames={BEATS.calmStart}>
        <KickerLabel />
      </Sequence>
    </AbsoluteFill>
  );
};

export default AdDesk;
