  const barProgress = interpolate(frame, [4, 24], [0, 1], {
    easing: EASE_SNAP,
    ...CLAMP,
  });
  const barGlintX = interpolate(frame, [22, 44], [-140, 920], {
    easing: EASE_OUT,
    ...CLAMP,
  });

  // Secondary minimal graphic rule along bottom of safe zone (f18..43)
  const subRuleProgress = interpolate(frame, [18, 43], [0, 1], {
    easing: EASE_OUT,
    ...CLAMP,
  });

  return (
    <AbsoluteFill style={{ backgroundColor: COLORS.magenta, overflow: "hidden" }}>
      {/* Dimensional magenta lighting mesh */}
      <div
        style={{
          position: "absolute",
          inset: 0,
          background: `radial-gradient(circle at 78% 24%, ${COLORS.magentaBright} 0%, ${COLORS.magenta} 48%, #981164 100%)`,
        }}
      />
      <div
        style={{
          position: "absolute",
          width: 980,
          height: 980,
          borderRadius: "50%",
          right: -260,
          top: 180 + orbShiftY,
          background:
            "radial-gradient(circle, rgba(255, 118, 206, 0.32) 0%, rgba(196, 28, 131, 0) 64%)",
          filter: "blur(55px)",
        }}
      />
      {/* Diagonal moving studio specular band */}
      <div
        style={{
          position: "absolute",
          top: -320,
          left: sheenX,
          width: 420,
          height: 2560,
          transform: "rotate(18deg)",
          background:
            "linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.09) 50%, transparent 100%)",
        }}
      />

      {/* Safe-Zone Poster Block: x120..960, y472..1200 (strictly below y424 badge box) */}
      <div
        style={{
          position: "absolute",
          left: SAFE.left,
          top: 472,
          width: SAFE.width,
          display: "flex",
          flexDirection: "column",
          alignItems: "flex-start",
        }}
      >
        {/* "$500" — 100% sharp, full opacity, full scale at frame 0 and held completely still */}
        <div
          style={{
            fontFamily: FONT_DISPLAY,
            fontSize: 220,
            fontWeight: 900,
            lineHeight: 0.9,
            letterSpacing: "-0.045em",
            fontVariantNumeric: "tabular-nums",
            color: COLORS.white,
            textShadow: "0 14px 40px rgba(82, 6, 54, 0.32)",
          }}
        >
          {COPY.prizeAmount}
        </div>

        {/* Cyan kinetic draw-bar divider */}
        <div
          style={{
            position: "relative",
            width: SAFE.width,
            height: 12,
            marginTop: 32,
            marginBottom: 34,
            backgroundColor: "rgba(255, 255, 255, 0.16)",
            borderRadius: 6,
            overflow: "hidden",
          }}
        >
          <div
            style={{
              width: `${barProgress * 100}%`,
              height: "100%",
              backgroundColor: COLORS.cyan,
              borderRadius: 6,
              boxShadow: "0 0 28px rgba(34, 211, 238, 0.65)",
            }}
          />
          <div
            style={{
