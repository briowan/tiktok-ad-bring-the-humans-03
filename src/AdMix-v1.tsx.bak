// ============================================================================
// B2 (f45-89, 45f) — WORD-BUILD (Clean White + Small Side Floating AgentToken)
// "Your AI agent can win it." word-by-word blur -> sharp
// ============================================================================

const Beat2WordBuild: React.FC = () => {
  const frame = useCurrentFrame();
  const { width, height } = useVideoConfig();

  const lines = useMemo(() => {
    const words = COPY.b2Headline.split(" ");
    return [
      { words: words.slice(0, 2), offset: 0 }, // "Your AI"
      { words: words.slice(2, 4), offset: 2 }, // "agent can"
      { words: words.slice(4, 6), offset: 4 }, // "win it."
    ];
  }, []);

  // Subtle vertical drift keeping the whole typography layout alive through f44
  const blockDriftY = interpolate(frame, [0, 44], [12, -10], {
    easing: EASE_IN_OUT,
    ...CLAMP,
  });

  // Animated magenta underline under "win" (word index 4)
  const winUnderlineT = interpolate(frame, [21, 39], [0, 1], {
    easing: EASE_SNAP,
    ...CLAMP,
  });

  // Small side-accent AgentToken continuous motion (lower-right: x≈787, y≈1130)
  const tokenEnter = interpolate(frame, [0, 14], [0, 1], {
    easing: EASE_OUT,
    ...CLAMP,
  });
  const tokenSpin = interpolate(frame, [0, 44], [-30, 20], {
    easing: EASE_IN_OUT,
    ...CLAMP,
  });
  const tokenBobY = Math.sin(frame * 0.14) * 0.07;
  const tokenScale = 0.58 * (0.86 + 0.14 * tokenEnter);
  const camX = interpolate(frame, [0, 44], [-0.45, 0.45], {
    easing: EASE_IN_OUT,
    ...CLAMP,
  });
  const camZ = interpolate(frame, [0, 44], [12.5, 11.7], {
    easing: EASE_OUT,
    ...CLAMP,
  });

  return (
    <AbsoluteFill style={{ backgroundColor: COLORS.white, overflow: "hidden" }}>
      {/* Ultra-clean warm-white paper depth tint */}
      <div
        style={{
          position: "absolute",
          inset: 0,
          background:
            "radial-gradient(circle at 82% 62%, rgba(196, 28, 131, 0.055) 0%, rgba(255,255,255,0) 46%)",
        }}
      />

      {/* Soft grounded shadow beneath the right-side floating AgentToken */}
      <div
        style={{
          position: "absolute",
          left: 660,
          top: 1292,
          width: 260,
          height: 44,
          borderRadius: "50%",
          background:
            "radial-gradient(ellipse at center, rgba(25,20,25,0.12) 0%, rgba(25,20,25,0) 70%)",
          transform: `scale(${(0.92 + Math.sin(frame * 0.14) * 0.06).toFixed(3)})`,
        }}
      />

      {/* Single ThreeCanvas for small side-accent AgentToken */}
      <AbsoluteFill style={{ pointerEvents: "none" }}>
        <ThreeCanvas
          width={width}
          height={height}
          dpr={1}
          camera={{ fov: 34, near: 0.1, far: 100 }}
          gl={CANVAS_GL}
          style={{ width: "100%", height: "100%" }}
        >
          <MixCameraRig position={[camX, 0, camZ]} target={[0, 0, 0]} fov={34} />
          <FloatingTokenRig frame={frame} />
          <group position={[0.96, -0.66 + tokenBobY, 0]}>
            <AgentToken
              frame={frame + 12}
              scale={tokenScale}
              spin={tokenSpin}
              ringGlow={0.28}
            />
          </group>
        </ThreeCanvas>
      </AbsoluteFill>

      {/* Giant 148px Word-by-Word Blur -> Sharp Headline (x120..960, y492..940) */}
      <div
        style={{
          position: "absolute",
          left: SAFE.left,
          top: 492,
          width: SAFE.width,
          transform: `translateY(${blockDriftY.toFixed(2)}px)`,
          display: "flex",
          flexDirection: "column",
          gap: 10,
        }}
      >
        {lines.map((line, lineIdx) => (
          <div
            key={lineIdx}
            style={{
              display: "flex",
              flexDirection: "row",
              alignItems: "baseline",
              gap: 32,
            }}
          >
            {line.words.map((word, wIdx) => {
              const globalIdx = line.offset + wIdx;
              const start = globalIdx === 0 ? -2 : globalIdx * 4;
              const t = interpolate(frame, [start, start + 10], [0, 1], {
                easing: EASE_SNAP,
                ...CLAMP,
              });
              const blurPx = interpolate(t, [0, 1], [16, 0], {
                easing: EASE_OUT,
                ...CLAMP,
              });
              const riseY = interpolate(t, [0, 1], [32, 0], {
                easing: EASE_SNAP,
                ...CLAMP,
              });
              const scale = interpolate(t, [0, 1], [0.94, 1], {
                easing: EASE_OUT,
                ...CLAMP,
              });
              const opacity = interpolate(t, [0, 0.5, 1], [0, 0.85, 1], {
                easing: EASE_OUT,
                ...CLAMP,
              });
              const isHeroWord = globalIdx === 4; // "win"

              return (
                <span
                  key={globalIdx}
                  style={{
                    position: "relative",
                    display: "inline-block",
                    fontFamily: FONT_DISPLAY,
                    fontSize: 148,
                    fontWeight: 800,
                    lineHeight: 0.96,
                    letterSpacing: "-0.042em",
                    color: isHeroWord ? COLORS.magenta : COLORS.ink,
                    opacity,
                    filter:
                      blurPx > 0.08 ? `blur(${blurPx.toFixed(2)}px)` : "none",
                    transform: `translateY(${riseY.toFixed(2)}px) scale(${scale.toFixed(4)})`,
                  }}
                >
                  {word}
                  {isHeroWord && (
                    <span
                      style={{
                        position: "absolute",
                        left: 0,
                        bottom: -10,
                        width: `${winUnderlineT * 100}%`,
                        height: 11,
                        borderRadius: 6,
                        backgroundColor: COLORS.magenta,
                        boxShadow: "0 6px 20px rgba(196, 28, 131, 0.32)",
                      }}
                    />
                  )}
                </span>
              );
            })}
          </div>
        ))}
      </div>

      <FilmGrain opacity={0.024} />
    </AbsoluteFill>
  );
};

// ============================================================================
// B3 (f90-149, 60f) — HERO 3D (Studio Light)
// Large AgentToken + orbiting rings + studio pedestal, camera orbit + push-in,
// small label "AI AGENT COMPETITION"
// ============================================================================

const B3_GEMS: ReadonlyArray<{
  pos: readonly [number, number, number];
  scale: number;
  color: string;
  phase: number;
  metalness: number;
}> = [
  { pos: [1.65, 1.08, -0.55], scale: 0.095, color: COLORS.magentaBright, phase: 0.4, metalness: 0.2 },
  { pos: [-1.58, 0.62, 0.45], scale: 0.088, color: COLORS.cyan, phase: 1.5, metalness: 0.2 },
  { pos: [1.52, -0.42, 0.72], scale: 0.082, color: COLORS.gold, phase: 2.6, metalness: 0.9 },
  { pos: [-1.46, 1.32, -0.68], scale: 0.075, color: "#eeecf2", phase: 3.4, metalness: 0.18 },
];

const HeroStage3D: React.FC<{ frame: number }> = ({ frame }) => {
  const { fps } = useVideoConfig();

  const shadowTex = useMemo(() => createSoftShadowTexture(), []);
  useEffect(() => {
    return () => {
      shadowTex.dispose();
    };
  }, [shadowTex]);

  // Continuous orbit (-24deg -> +22deg) + cinematic push-in (13.4 -> 11.4)
  const orbitT = interpolate(frame, [0, 59], [0, 1], {
    easing: EASE_IN_OUT,
    ...CLAMP,
  });
  const pushT = interpolate(frame, [0, 59], [0, 1], {
    easing: EASE_OUT,
    ...CLAMP,
  });

  const angle = -0.42 + orbitT * 0.8;
  const dist = 13.4 - pushT * 2.0;
  const camX = Math.sin(angle) * dist;
  const camZ = Math.cos(angle) * dist;
  const camY = 1.95 - pushT * 0.55 + Math.sin(orbitT * Math.PI) * 0.25;

  const entrySpring = spring({
    frame,
    fps,
    config: { damping: 14, stiffness: 155, mass: 0.9 },
  });
  const heroScale = 1.38 * (0.86 + 0.14 * entrySpring);
  const heroFloatY = 0.2 + Math.sin(frame * 0.095) * 0.055;
  const heroSpin = interpolate(frame, [0, 59], [-18, 22], {
    easing: EASE_IN_OUT,
    ...CLAMP,
  });

  // Dedicated outer orbiting studio halo ring + satellite node
  const outerRingRotX = 1.24 + Math.sin(frame * 0.05) * 0.08;
  const outerRingRotY = -0.25 + frame * 0.036;
  const outerRingRotZ = 0.18 + Math.cos(frame * 0.045) * 0.06;
  const satAngle = 0.4 + frame * 0.068;

  return (
    <group>
      <MixCameraRig position={[camX, camY, camZ]} target={[0, -0.1, 0]} fov={34} />
      <StudioBg frame={frame} tone="light" withLights />

      {/* Sculptural studio pedestal resting cleanly on FLOOR_Y = -1.35 */}
      <group position={[0, FLOOR_Y + 0.12, 0]}>
        <mesh castShadow receiveShadow>
          <cylinderGeometry args={[1.64, 1.82, 0.24, 72]} />
          <meshStandardMaterial color="#44414e" metalness={0.5} roughness={0.36} />
        </mesh>
        <mesh position={[0, 0.126, 0]} rotation={[Math.PI / 2, 0, 0]}>
          <torusGeometry args={[1.62, 0.032, 24, 96]} />
          <meshStandardMaterial
            color={COLORS.gold}
            metalness={0.94}
            roughness={0.16}
            envMapIntensity={1.65}
          />
        </mesh>
        <mesh position={[0, 0.13, 0]} rotation={[Math.PI / 2, 0, 0]}>
          <torusGeometry args={[1.28, 0.015, 16, 80]} />
          <meshStandardMaterial
            color={COLORS.cyan}
            emissive={COLORS.cyan}
            emissiveIntensity={0.65 + Math.sin(frame * 0.12) * 0.2}
            roughness={0.18}
          />
        </mesh>
        <mesh position={[0, -0.114, 0]} rotation={[-Math.PI / 2, 0, 0]}>
          <planeGeometry args={[5.2, 4.4]} />
          <meshBasicMaterial map={shadowTex} transparent depthWrite={false} opacity={0.9} />
        </mesh>
      </group>

      {/* Hero AgentToken + extra outer kinetic orbital halo ring */}
      <group position={[0, heroFloatY, 0]}>
        <AgentToken
          frame={frame}
          scale={heroScale}
          spin={heroSpin}
          ringGlow={0.48 + Math.sin(frame * 0.11) * 0.14}
        />

        <group rotation={[outerRingRotX, outerRingRotY, outerRingRotZ]}>
          <mesh castShadow>
            <torusGeometry args={[1.56, 0.022, 20, 96]} />
            <meshPhysicalMaterial
              color={COLORS.cyanSoft}
              emissive={COLORS.cyan}
              emissiveIntensity={0.42}
              metalness={0.35}
              roughness={0.12}
              clearcoat={1}
            />
          </mesh>
          <mesh position={[Math.cos(satAngle) * 1.56, Math.sin(satAngle) * 1.56, 0]}>
            <sphereGeometry args={[0.056, 20, 20]} />
            <meshStandardMaterial
              color={COLORS.magentaBright}
              emissive={COLORS.magentaBright}
              emissiveIntensity={0.9}
              roughness={0.15}
            />
          </mesh>
        </group>
      </group>

      {/* Depth-parallax faceted gem accents */}
      <group>
        {B3_GEMS.map((g, idx) => (
          <mesh
            key={idx}
            position={[
              g.pos[0],
              g.pos[1] + Math.sin(frame * 0.12 + g.phase) * 0.07,
              g.pos[2],
            ]}
            rotation={[g.phase + frame * 0.024, g.phase * 1.3 + frame * 0.03, 0.2]}
            scale={g.scale}
          >
            <octahedronGeometry args={[1, 0]} />
            <meshPhysicalMaterial
              color={g.color}
              metalness={g.metalness}
              roughness={0.14}
              clearcoat={0.9}
            />
          </mesh>
        ))}
      </group>
    </group>
  );
};

